{
  "name": "explore-ai",
  "version": "0.0.1",
  "private": true,
  "description": "Demo / learning platform for conversational AI built with Spring AI and Angular: Chat, RAG, tool calling, and quality evaluation.",
  "keywords": [
    "java",
    "spring-boot",
    "spring-ai",
    "angular",
    "typescript",
    "gradle",
    "rag",
    "llm",
    "embeddings",
    "vector-database",
    "ollama",
    "deepseek",
    "tool-calling",
    "mcp",
    "onnx",
    "computer-vision",
    "speech-recognition",
    "llm-evaluation",
    "demo"
  ],
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "build": "node scripts/inject-datadog-env.mjs && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "clean": "rm -rf dist .angular node_modules/.cache",
    "prepare": "husky",
    "vision:verify": "chmod +x scripts/verify-vision.sh && ./scripts/verify-vision.sh all",
    "vision:models": "chmod +x scripts/download-vision-models.sh && ./scripts/download-vision-models.sh",
    "server:test": "./gradlew test",
    "server:test:watch": "./gradlew test --continuous",
    "server:test:coverage": "./gradlew test jacocoTestReport"
  },
  "dependencies": {
    "@a2ui/angular": "^0.13.0",
    "@a2ui/web_core": "^0.14.0",
    "@analogjs/vite-plugin-angular": "^2.9.1",
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@ant-design/icons-angular": "^22.1.1",
    "@datadog/browser-rum": "^7.16.1",
    "@floating-ui/dom": "^1.8.0",
    "@foblex/flow": "^19.3.0",
    "@js-joda/core": "^6.3.0",
    "@launchdarkly/js-client-sdk": "^4.13.0",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/lucide": "^36.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "nanoid": "^6.0.2",
    "ng-zorro-antd": "^22.1.2",
    "ng-zorro-x": "0.6.0-alpha.1",
    "ngx-echarts": "^22.0.0",
    "ngx-sonner": "^3.1.0",
    "postcss": "^8.5.31",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@analogjs/vitest-angular": "^2.9.1",
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.5",
    "@vitest/browser": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "angular-eslint": "22.6.0",
    "eslint": "^10.13.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "sass-embedded": "^1.106.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "^5.0.5",
    "zard-cli": "1.1.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "engines": {
    "node": "24.x"
  }
}
