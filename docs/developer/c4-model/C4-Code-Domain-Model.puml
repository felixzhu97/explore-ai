@startuml C4-Code-Domain-Model
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}

title Code diagram (C4) — Domain model (by business domain)
hide empty members

legend right
  |= Stereotype |= Meaning |
  | <<Abstract>> | 抽象基类 |
  | <<AggregateRoot>> | 聚合根 |
  | <<Entity>> | 实体 |
  | <<ValueObject>> | 值对象 |
  | <<Enum>> | 枚举 |
  | <<DomainEvent>> | 领域事件 |
  | <<DomainService>> | 领域服务 |
  | <<Repository>> | 仓储端口 |
  | <<FilterDef>> | Hibernate 过滤器定义 |
endlegend

note as N_LAYERS
  controller → service → domain ← infra
  Aggregates encapsulate invariants; application orchestrates use cases.
  ChatMessage bodies persist via Spring AI ChatMemory bridge.
  Kernel: Domain Kernel + Common packages below.
  Preferred Terms: docs/Glossary.md
end note

' ── Domain Kernel ──────────────────────────────────────────
package "Domain Kernel" as pkg_base {
  interface EntityId <<ValueObject>> {
    +value()
  }
  class AbstractUuidId <<ValueObject>> {
    +value: UUID
    --
    +value(): String
    +asUuid(): UUID
    +{static} generate()
    +{static} of(uuid)
  }
  class AbstractEntity <<Abstract>> {
    +id: IdT
    +createdAt: Instant @CreationTimestamp
    +updatedAt: Instant @UpdateTimestamp
    +version: Long
    --
    +touchUpdatedAt()
  }
  class AbstractImmutableEntity <<Abstract>> {
    +id: IdT
    +createdAt: Instant
  }
}

EntityId <|.. AbstractUuidId
AbstractUuidId --> AbstractEntity : embedded id
AbstractUuidId --> AbstractImmutableEntity : embedded id

' ── Common (owner-keyed bases) ─────────────────────────────
package "Common" as pkg_common_kernel {
  class AbstractOwnerKeyedEntity <<Abstract>> {
    @Filter(ownerPartition)
    +ownerKey: OwnerKey NOT NULL
    --
    +belongsTo(ownerKey)
    +getOwnerKeyValue()
    +transferTo(accountOwnerKey)
  }
  class AbstractNamedOwnerEntity <<Abstract>> {
    +name: String
    --
    +rename(name)
  }
  class AbstractEnableableNamedOwnerEntity <<Abstract>> {
    +enabled: boolean
    --
    +enable()
    +disable()
    +changeEnabled(enabled)
  }
  class AbstractEnableableDescribedOwnerEntity <<Abstract>> {
    +description: String
    --
    +updateDescription(text)
  }
  class AbstractTimedRunEntity <<Abstract>> {
    +startedAt: Instant (createdAt → started_at)
    +finishedAt: Instant
    --
    +markFinished(at)
  }
  class OwnerPartition <<FilterDef>> {
    ownerPartition: owner_key = :ownerKey
    applyToLoadByKey = true
  }
  class AbstractAppendOnlyEvent <<Abstract>> {
    +occurredAt: Instant
  }
  class OwnerKey <<ValueObject>> {
    +value: String
    --
    +{static} forClient(id)
    +{static} forAccount(id)
    +isClient()
    +isAccount()
    +requireMergeableInto(target)
  }
  class DomainStrings <<DomainService>> {
    +{static} normalizeName(raw)
    +{static} copyNameCandidates(base, maxLength)
  }
  interface OwnerScopedRepository<E, I> <<Repository>> {
    +save(entity)
    +findByIdAndOwnerKey(id, ownerKey)
    +findAllByOwnerKey(ownerKey)
    +deleteByIdAndOwnerKey(id, ownerKey)
    +existsByOwnerKeyAndNameIgnoringId(ownerKey, name, excludeId)
  }
}

AbstractEntity <|-- AbstractOwnerKeyedEntity
AbstractOwnerKeyedEntity <|-- AbstractNamedOwnerEntity
AbstractNamedOwnerEntity <|-- AbstractEnableableNamedOwnerEntity
AbstractEnableableNamedOwnerEntity <|-- AbstractEnableableDescribedOwnerEntity
AbstractImmutableEntity <|-- AbstractAppendOnlyEvent
AbstractImmutableEntity <|-- AbstractTimedRunEntity
AbstractOwnerKeyedEntity --> OwnerKey
AbstractOwnerKeyedEntity ..> OwnerPartition : filtered by

' ── chat ───────────────────────────────────────────────────
package "Chat" as pkg_chat {
  class ChatSession <<AggregateRoot>> {
    +id: ChatSessionId
    +ownerKey: OwnerKey
    +title: SessionTitle
    --
    +{static} create(title, ownerKey)
    +{static} startDefault(ownerKey)
    +{static} startWithId(id, ownerKey)
    +{static} of(id, title, createdAt, ownerKey)
    +rename(newTitle)
    +needsGeneratedTitle()
    +applyGeneratedTitle(title)
    +restoreMessages(messages)
    +recordExchange(messages)
    +lastAssistantMessage(): Optional
    +firstUserMessage(): Optional
    +isInactiveSince(cutoff)
    +isEmpty()
  }
  class SessionTitle <<ValueObject>> {
    +value: String
    --
    +{static} DEFAULT
    +{static} of(raw)
    +{static} fromFirstMessage(text)
    +{static} generated(modelTitle)
    +isDefault()
  }
  class ChatMessage <<Entity>> {
    +id: MessageId
    +text: String
    +messageType: ChatMessageType
    --
    +{static} createUserMessage(text)
    +{static} createAssistantMessage(text)
    +{static} restore(id, text, type, timestamp)
    +isFromUser()
    +isFromAssistant()
    +withText(newText)
  }
  enum ChatMessageType <<Enum>> {
    USER
    ASSISTANT
  }
  class WebSource <<ValueObject>> {
    +url: String
    +title: String
  }
  interface ChatSessionRepository <<Repository>> {
    +save(session)
    +findById(id)
  }
  interface ChatWebSourcesRepository <<Repository>> {
    +findByConversationId(conversationId)
  }
}

ChatSession "1" *-- "0..*" ChatMessage
ChatSession --> SessionTitle
ChatMessage --> ChatMessageType

' ── rag ────────────────────────────────────────────────────
package "RAG" as pkg_rag {
  class RagDocument <<AggregateRoot>> {
    +id: DocumentId
    +ownerKey: OwnerKey
    +title: String
    +status: DocumentStatus
    +chunkCount: int
    --
    +{static} startIngestion(title, fileName, fileSize, ownerKey)
    +completeIngestion(chunkCount)
    +failIngestion()
    +newChunk(index, content, sourceMetadata)
    +isSearchable()
  }
  class DocumentChunk <<Entity>> {
    +id: ChunkId
    +documentId: DocumentId
    +ownerKey: OwnerKey
    +content: String
    --
    +{static} create(...)
    +withEmbedding(vector)
    +similarityTo(queryVector)
    +excerpt()
  }
  class ScoredChunk <<ValueObject>> {
    +chunk: DocumentChunk
    +score: double
    --
    +meets(threshold)
  }
  enum DocumentStatus <<Enum>> {
    UPLOADING
    PROCESSING
    READY
    FAILED
  }
  class SourceDocument <<ValueObject>> {
    +content: String
    +score: double
  }
  interface DocumentRepository <<Repository>> {
    +save(document)
    +findById(id)
  }
}

RagDocument "1" *-- "0..*" DocumentChunk
RagDocument --> DocumentStatus
ScoredChunk --> DocumentChunk

' ── pipeline + skill ───────────────────────────────────────
package "Pipeline" as pkg_pipeline {
  class AgentPipeline <<AggregateRoot>> {
    +nodes: List
    +edges: List
    --
    +{static} create(nodes, edges)
    +executionOrder()
  }
  class AgentDefinition <<Entity>> {
    +type: AgentType
    +systemPrompt: String
  }
  class PipelineNode <<ValueObject>> {
    +agentType: AgentType
    --
    +toDefinition(fallback)
  }
  class PipelineTemplate <<Entity>> {
    +id: PipelineTemplateId
    +name: String
    +agentTypes: List (workers only)
    --
    +isRunnable()
    +toLinearPipeline()
    +composeInvokeMessage(scheduleBrief)
  }
  class SavedAgent <<Entity>> {
    +id: SavedAgentId
    +typeKey: String
    --
    +hasType(agentType)
    +toAgentDefinition()
  }
  class AgentCatalog <<DomainService>> {
    +{static} merge(builtins, library)
  }
  interface PipelineTemplateRepository <<Repository>> {
  }
  interface SavedAgentRepository <<Repository>> {
    +findEnabledByOwnerKey(ownerKey)
  }
  interface AgentRegistry <<Repository>> {
    +listBuiltins(language)
    +listAll(ownerKey, language)
  }
}

package "Skill" as pkg_skill {
  class Skill <<AggregateRoot>> {
    +id: SkillId
    +name: String
    +enabled: boolean
    --
    +{static} create(...)
    +update(name, instructions, tools)
    +changeEnabled(enabled)
    +toPromptSection()
  }
  interface SkillRepository <<Repository>> {
    +findEnabledByOwnerKeyAndIds(ownerKey, ids)
  }
}

' ── automation ─────────────────────────────────────────────
package "Automation" as pkg_automation {
  class AutomationSchedule <<AggregateRoot>> {
    @DynamicUpdate
    +id: ScheduleId
    +timing: ScheduleTiming
    +pipelineTemplateId: PipelineTemplateId
    +enabled: boolean
    --
    +{static} create(...)
    +{static} createOnce(...)
    +update(...)
    +turnOn(now, cronSchedule)
    +disable()
    +hasPendingRun(now)
    +pendingRunAt(): Optional
    +provisionalNextRunAt(now, cronSchedule)
    +recordRunFinished(finishedAt, cronSchedule)
    +resultEmail(textBody, htmlBody)
    +isOnce()
  }
  class ScheduleTiming <<ValueObject>> {
    +kind: ScheduleKind
    +cronExpression: String
    +timezone: String
    --
    +{static} cron(expression, timezone)
    +{static} once(timezone)
  }
  interface CronSchedule <<DomainService>> {
    +nextRunAfter(expression, timezone, after)
  }
  class AutomationRun <<Entity>> {
    @DynamicUpdate @Filter(ownerPartition)
    +id: RunId
    +ownerKey: OwnerKey
    +status: RunStatus
    --
    +{static} start(scheduleId, ownerKey)
    +succeed(excerpt, emailStatus)
    +failBeforeEmail(error)
    +skipForQuota()
  }
  enum RunStatus <<Enum>> {
    SUCCESS
    FAILED
    SKIPPED
  }
}

AutomationSchedule "1" o-- "0..*" AutomationRun
AutomationSchedule --> ScheduleTiming
AutomationSchedule ..> CronSchedule : next run from

' ── account ────────────────────────────────────────────────
package "Account" as pkg_account {
  class AccountUser <<Entity>> {
    +provider: String <<NaturalId>>
    +subject: String <<NaturalId>>
    +email: ContactEmail
    +displayName: String
    +linkedClientId: ClientId
    --
    +{static} create(identity, email, displayName)
    +linkBrowser(clientId, email, displayName)
    +recordSignIn(email, displayName)
    +unlinkBrowser()
    +ownerKey()
    +guestOwnerKey(): Optional
    +displayLabel()
  }
  class ExternalIdentity <<ValueObject>> {
    +provider: String
    +subject: String
    --
    +{static} of(provider, subject)
    +{static} iam(subject)
  }
  class ContactEmail <<ValueObject>> {
    +value: String
    --
    +{static} ofNullable(raw)
  }
  class ClientId <<ValueObject>> {
    +value: String (UUID)
    --
    +{static} parse(raw)
    +{static} generate()
  }
}

AccountUser --> ExternalIdentity : identified by
AccountUser --> ContactEmail
AccountUser --> ClientId : linked browser

' ── billing ────────────────────────────────────────────────
package "Billing" as pkg_billing {
  enum Plan <<Enum>> {
    FREE
    PRO
  }
  class QuotaPolicy <<ValueObject>> {
    +plan: Plan
    --
    +dailyLimit()
    +ipDailyLimit()
    +globalDailyLimit(): OptionalInt
  }
  class DailyUsage <<ValueObject>> {
    +day: LocalDate
    +count: int
    --
    +remaining(limit, today)
  }
  class QuotaSubject <<ValueObject>> {
    +key: String
    --
    +{static} owner(ownerKey)
    +{static} address(ip)
    +{static} GLOBAL
  }
  class QuotaDecision <<ValueObject>> {
    +allowed: boolean
    +plan: Plan
    +limit: int
    +remaining: int
  }
}

QuotaPolicy --> Plan
QuotaDecision --> Plan

' ── mcp ────────────────────────────────────────────────────
package "MCP" as pkg_mcp {
  class McpSession <<AggregateRoot>> {
    +id: UUID
    +status: McpSessionStatus
    --
    +{static} open(serverName, toolCount)
    +activate()
    +close()
    +isActive()
  }
  class McpSessionRegistry <<DomainService>> {
    +registerSession(serverName, toolCount)
    +closeSession(sessionId)
    +activeSessions()
  }
}

' ── metrics ────────────────────────────────────────────────
package "Metrics" as pkg_metrics {
  class AiInvocationEvent <<DomainEvent>> {
    @Immutable
    +domain: AiDomain
    +outcome: InvocationOutcome
    +ownerKey: OwnerKey (required at creation)
    +latencyMs: long
    --
    +{static} succeeded(domain, operation, latency, ownerKey)
    +{static} failed(domain, operation, latency, ownerKey, error)
  }
  class Latency <<ValueObject>> {
    +millis: long
    --
    +{static} since(startNanos)
  }
  class ErrorSummary <<ValueObject>> {
    +code: String
    +message: String
    --
    +{static} of(throwable)
  }
  class TokenUsage <<ValueObject>> {
    +prompt: Integer
    +completion: Integer
    --
    +total()
  }
  class InvocationStats <<ValueObject>> {
    +requests: long
    +errors: long
    --
    +errorRate()
    +successRate()
  }
  class MetricsWindow <<ValueObject>> {
    +{static} parse(range)
    +from(now)
  }
  class LatencyStats <<ValueObject>> {
    +{static} fromSorted(latencies)
  }
  enum AiDomain <<Enum>> {
    CHAT
    RAG
    AGENTS
    TOOLS
    VISION
    WORKFLOW
  }
}

' ── tools (sample) ─────────────────────────────────────────
package "Tool Calling" as pkg_tools {
  class WeatherReport <<Entity>> {
    +location: String
    +current: WeatherInfo
  }
}

' ── cross-cutting (kernel note) ─────────────────────────────
note as KERNEL_NOTE
  OwnerKey and owner-keyed aggregate bases live in
  the **Common** package above.
  Attribute converters (OwnerKey, enums, JSON lists) live in domain.vo.
  Typed ids map to native UUID columns.
  Owner-scoped repositories run inside OwnerPartitionScope (infra),
  which enables the ownerPartition filter; background jobs stay unfiltered.
  Default JPA snake_case naming; no @Table/@Column(name=) in domain.
end note

AbstractOwnerKeyedEntity <|-- ChatSession : metadata only
AbstractOwnerKeyedEntity <|-- RagDocument
AbstractEnableableDescribedOwnerEntity <|-- Skill
AbstractEnableableDescribedOwnerEntity <|-- PipelineTemplate
AbstractEnableableDescribedOwnerEntity <|-- SavedAgent
AbstractEnableableNamedOwnerEntity <|-- AutomationSchedule
AbstractTimedRunEntity <|-- AutomationRun
AbstractEntity <|-- AccountUser
AbstractAppendOnlyEvent <|-- AiInvocationEvent

OwnerScopedRepository <|-- SkillRepository
OwnerScopedRepository <|-- PipelineTemplateRepository

ChatSession ..> OwnerKey : owned by
RagDocument ..> OwnerKey : owned by
Skill ..> OwnerKey : owned by
AccountUser ..> OwnerKey : links browser
AiInvocationEvent ..> OwnerKey : attributed to
AutomationSchedule ..> PipelineTemplate : by id (PipelineTemplateId)
AiInvocationEvent --> Latency
AiInvocationEvent --> ErrorSummary
AiInvocationEvent --> TokenUsage
PipelineTemplate ..> AgentPipeline : builds linear
AgentCatalog ..> SavedAgent : overrides builtin
AgentCatalog ..> AgentDefinition
AutomationRun ..> OwnerPartition : filtered by

N_LAYERS .. pkg_chat
N_LAYERS .. pkg_base
N_LAYERS .. pkg_common_kernel
KERNEL_NOTE .. pkg_common_kernel

@enduml
