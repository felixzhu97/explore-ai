@startuml C4-Code-Domain-Model
!include style-zinc.puml

title Code diagram (C4) — Domain model (aligned to com.ai.*.domain)

legend right
  |= 标题色 |= Type |
  | <color:#334155>Abstract</color> | 抽象基类 |
  | <color:#064E3B>AggregateRoot</color> | 聚合根 |
  | <color:#1E3A8A>Entity</color> | 实体 |
  | <color:#9A3412>ValueObject</color> | 值对象 |
  | <color:#78350F>Enum</color> | 枚举 |
  | <color:#581C87>DomainEvent</color> | 领域事件 |
  | <color:#3730A3>DomainService</color> | 领域服务 |
  | <color:#52525B>Repository</color> | 仓储端口 |
endlegend

note as N_LAYERS
  controller → service → domain ← infra
  Aggregates encapsulate invariants; application orchestrates use cases.
  ChatMessage bodies persist via Spring AI ChatMemory bridge.
  Kernel: com.ai.base + com.ai.common.domain (see packages below).
end note

' ── domain kernel (com.ai.base) ─────────────────────────────
package "com.ai.base" as pkg_base {
  interface EntityId <<ValueObject>> {
    +value()
  }
  class AbstractUuidId <<ValueObject>> {
    +value: String
    --
    +{static} generate()
    +{static} of(uuid)
  }
  class AbstractEntity <<Abstract>> {
    +id: IdT
    +createdAt: Instant
    +updatedAt: Instant
    +version: Long
    --
    +touchUpdatedAt()
  }
  class AbstractImmutable <<Abstract>> {
    +id: IdT
    +createdAt: Instant
  }
  class BaseJpaConfig <<Configuration>> {
    EnableJpaAuditing
    EnableJpaRepositories
  }
}

EntityId <|.. AbstractUuidId
AbstractUuidId --> AbstractEntity : embedded id
AbstractUuidId --> AbstractImmutable : embedded id

' ── aggregate bases (com.ai.common.domain.model) ───────────
package "com.ai.common.domain" as pkg_common_kernel {
  class AbstractOwnerKeyedEntity <<Abstract>> {
    +ownerKey: OwnerKey
    --
    +belongsTo(ownerKey)
    +belongsToClient(value)
    +rebindOwnerKey(ownerKey)
  }
  class AbstractNamedOwnerEntity <<Abstract>> {
    +name: String
    --
    +rename(name)
  }
  class AbstractDescribedOwnerEntity <<Abstract>> {
    +description: String
  }
  class AbstractEnableableDescribedOwnerEntity <<Abstract>> {
    +enabled: boolean
    --
    +enable()
    +disable()
  }
  class AbstractTimedRunEntity <<Abstract>> {
    +startedAt: Instant
    +finishedAt: Instant
    --
    +markFinished(at)
  }
  class AbstractAppendOnlyEvent <<Abstract>> {
    +occurredAt: Instant
  }
  class OwnerKey <<ValueObject>> {
    +value: String
    --
    +{static} forClient(id)
    +{static} forAccount(id)
  }
  interface ClientOwnedRepository <<Repository>> {
    +findByIdAndOwnerKey(id, ownerKey)
    +findAllByOwnerKey(ownerKey)
    +deleteByIdAndOwnerKey(id, ownerKey)
  }
  interface ClientIdOwnedNamedRepository <<Repository>> {
    +findByIdAndClientId(id, clientId)
    +findAllByClientId(clientId)
    +deleteByIdAndClientId(id, clientId)
    +existsByClientIdAndNameIgnoringId(clientId, name, excludeId)
  }
}

AbstractEntity <|-- AbstractOwnerKeyedEntity
AbstractOwnerKeyedEntity <|-- AbstractNamedOwnerEntity
AbstractNamedOwnerEntity <|-- AbstractDescribedOwnerEntity
AbstractDescribedOwnerEntity <|-- AbstractEnableableDescribedOwnerEntity
AbstractImmutable <|-- AbstractAppendOnlyEvent
AbstractOwnerKeyedEntity --> OwnerKey

' ── chat ───────────────────────────────────────────────────
package "com.ai.chat.domain" as pkg_chat {
  class ChatSession <<AggregateRoot>> {
    +id: ChatSessionId
    +ownerKey: OwnerKey
    +title: String
    --
    +{static} create(title, clientId)
    +{static} reconstitute(...)
    +rename(newTitle)
    +addUserMessage(text)
    +addAssistantMessage(text)
    +getRecentMessages(count)
    +clearMessages()
    +replaceMessages(messages)
    +belongsTo(clientId)
    +isEmpty()
  }
  class ChatMessage <<Entity>> {
    +id: MessageId
    +text: String
    +messageType: ChatMessageType
    --
    +{static} createUserMessage(text)
    +{static} createAssistantMessage(text)
    +isFromUser()
    +isFromAssistant()
    +withText(newText)
  }
  enum ChatMessageType <<Enum>> {
    USER
    ASSISTANT
  }
  class WebSource <<ValueObject>> {
    +url: String
    +title: String
  }
  interface ChatSessionRepository <<Repository>> {
    +save(session)
    +findById(id)
  }
  interface ChatWebSourcesRepository <<Repository>> {
    +findByContentHash(hash)
  }
}

ChatSession "1" *-- "0..*" ChatMessage
ChatMessage --> ChatMessageType

' ── rag ────────────────────────────────────────────────────
package "com.ai.rag.domain" as pkg_rag {
  class Document <<AggregateRoot>> {
    +id: DocumentId
    +ownerKey: OwnerKey
    +title: String
    +status: DocumentStatus
    --
    +markProcessing()
    +markReady()
    +markFailed()
    +updateTitle(newTitle)
  }
  class DocumentChunk <<Entity>> {
    +id: ChunkId
    +documentId: DocumentId
    +content: String
    --
    +{static} create(...)
    +withEmbedding(vector)
  }
  enum DocumentStatus <<Enum>> {
    UPLOADING
    PROCESSING
    READY
    FAILED
  }
  class SourceDocument <<ValueObject>> {
    +text: String
    +score: double
  }
  interface IDocumentRepository <<Repository>> {
    +save(document)
    +findById(id)
  }
}

Document "1" *-- "0..*" DocumentChunk
Document --> DocumentStatus

' ── pipeline + skill ───────────────────────────────────────
package "com.ai.pipeline.domain" as pkg_pipeline {
  class AgentPipeline <<AggregateRoot>> {
    +nodes: List
    +edges: List
    --
    +{static} create(nodes, edges)
    +executionOrder()
  }
  class AgentDefinition <<Entity>> {
    +type: AgentType
    +systemPrompt: String
  }
  class SavedWorkflowTemplate <<Entity>> {
    +id: WorkflowTemplateId
    +name: String
  }
  interface WorkflowTemplateRepository <<Repository>> {
  }
  interface AgentRegistry <<Repository>> {
    +findByType(type)
  }
}

package "com.ai.skill.domain" as pkg_skill {
  class Skill <<AggregateRoot>> {
    +id: SkillId
    +name: String
    +enabled: boolean
    --
    +{static} create(...)
    +update(name, instructions, tools)
    +enable()
    +disable()
  }
  interface SkillRepository <<Repository>> {
    +findEnabledByClientIdAndIds(clientId, ids)
  }
}

' ── automation ─────────────────────────────────────────────
package "com.ai.automation.domain" as pkg_automation {
  class AutomationSchedule <<AggregateRoot>> {
    +id: ScheduleId
    +kind: ScheduleKind
    +enabled: boolean
    --
    +{static} create(...)
    +{static} createOnce(...)
    +update(...)
    +enable(nextRunAt)
    +disable()
    +markExecuted(finishedAt, nextRunAt)
    +completeOnce(finishedAt)
    +isOnce()
  }
  class AutomationRun <<Entity>> {
    +id: RunId
    +status: RunStatus
  }
  enum RunStatus <<Enum>> {
    RUNNING
    SUCCEEDED
    FAILED
  }
}

AutomationSchedule "1" o-- "0..*" AutomationRun

' ── account ────────────────────────────────────────────────
package "com.ai.account.domain" as pkg_account {
  class AccountUser <<Entity>> {
    +provider: String
    +linkedClientId: String
    --
    +{static} create(provider, subject, email, clientId)
    +linkSession(email, clientId)
    +unlinkBrowser()
  }
}

' ── mcp ────────────────────────────────────────────────────
package "com.ai.mcp.domain" as pkg_mcp {
  class McpSession <<AggregateRoot>> {
    +id: UUID
    +status: McpSessionStatus
    --
    +{static} open(serverName, toolCount)
    +activate()
    +close()
    +isActive()
  }
  class McpSessionManager <<DomainService>> {
    +register(session)
    +close(sessionId)
  }
}

' ── metrics ────────────────────────────────────────────────
package "com.ai.metrics.domain" as pkg_metrics {
  class AiInvocationEvent <<DomainEvent>> {
    +domain: AiDomain
    +outcome: InvocationOutcome
    +latencyMs: long
    --
    +{static} builder()
  }
  enum AiDomain <<Enum>> {
    CHAT
    RAG
    AGENTS
    TOOLS
    VISION
  }
}

' ── tools (sample) ─────────────────────────────────────────
package "com.ai.tools.domain" as pkg_tools {
  class WeatherReport <<Entity>> {
    +location: String
    +current: WeatherInfo
  }
}

' ── cross-cutting (kernel note) ─────────────────────────────
note as KERNEL_NOTE
  OwnerKey and aggregate bases are defined in
  **com.ai.common.domain** (pkg_common_kernel above).
end note

AbstractEntity <|-- ChatSession : metadata only
AbstractOwnerKeyedEntity <|-- Document
AbstractEnableableDescribedOwnerEntity <|-- Skill
AbstractEnableableDescribedOwnerEntity <|-- SavedWorkflowTemplate
AbstractNamedOwnerEntity <|-- AutomationSchedule
AbstractTimedRunEntity <|-- AutomationRun
AbstractEntity <|-- AccountUser
AbstractAppendOnlyEvent <|-- AiInvocationEvent

ClientIdOwnedNamedRepository <|-- SkillRepository
ClientIdOwnedNamedRepository <|-- WorkflowTemplateRepository

ChatSession ..> OwnerKey : owned by
Document ..> OwnerKey : owned by
Skill ..> OwnerKey : owned by
AccountUser ..> OwnerKey : links browser

N_LAYERS .. pkg_chat
N_LAYERS .. pkg_base
N_LAYERS .. pkg_common_kernel
KERNEL_NOTE .. pkg_common_kernel

@enduml
