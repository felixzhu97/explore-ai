hide empty members

<style>
  document {
    BackgroundColor #FAFAFA
    FontColor #18181B
  }
  title {
    FontColor #09090B
    FontSize 18
    FontStyle bold
    Margin 20
  }
  legend {
    BackgroundColor #FFFFFF
    BorderColor #E4E4E7
    FontColor #3F3F46
    FontSize 11
