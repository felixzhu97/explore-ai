    FontSize 11
    RoundCorner 10
    Padding 10
    Shadowing 0
  }
  classDiagram {
    LineColor #A1A1AA
    LineThickness 1.2
    FontColor #52525B
    FontSize 11
    Padding 8
    Margin 10
    RoundCorner 12
