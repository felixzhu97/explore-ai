    class {
      BackgroundColor #FFFFFF
      BorderColor #D4D4D8
      FontColor #18181B
      FontSize 12
      RoundCorner 12
      Padding 8
      Shadowing 0
    }
    interface {
      BackgroundColor #F4F4F5
      BorderColor #A1A1AA
      FontColor #3F3F46
      FontStyle italic
      RoundCorner 12
      Padding 8
    }
    enum {
      BackgroundColor #FFFBEB
      BorderColor #F59E0B
