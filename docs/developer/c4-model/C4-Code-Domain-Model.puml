      FontColor #52525B
      FontSize 11
    }

    ' Stereotype accents (calm, modern; not decorative)
    .AggregateRoot {
      BackgroundColor #ECFDF5
      BorderColor #10B981
      FontColor #064E3B
      BorderThickness 1.5
    }
    .Entity {
      BackgroundColor #EFF6FF
      BorderColor #3B82F6
      FontColor #1E3A8A
      BorderThickness 1.5
    }
    .ValueObject {
      BackgroundColor #FFF7ED
      BorderColor #FB923C
      FontColor #7C2D12
    }
    .DomainService {
      BackgroundColor #EEF2FF
      BorderColor #6366F1
      FontColor #312E81
      FontStyle italic
    }
    .Repository {
      BackgroundColor #F4F4F5
      BorderColor #71717A
      FontColor #27272A
      FontStyle italic
    }
  }
</style>

legend right
  |= Stereotype |= Meaning in this codebase |
  | <<AggregateRoot>> | Transaction boundary; external access via root |
  | <<Entity>> | Identity + lifecycle; private ctor + factory |
  | <<ValueObject>> | Immutable; usually Java record / enum |
  | <<DomainService>> | Stateless domain logic not owned by one entity |
  | <<Repository>> | Domain outbound port (interface in domain/) |
  | | |
  | **No shared Java base** | There is no Entity / AggregateRoot class in com.ai.common |
  | **Preferred Terms** | See docs/Glossary.md |
endlegend

note as N_CONVENTION
  Architecture: web → application → domain ← infrastructure
  Domain has no framework annotations.
  Ports live under domain/repository/ (not domain/port/).
end note

