@startuml C4-Code-Domain-Model
!include style-zinc.puml

title Code diagram (C4) — AI Platform domain model (DDD + behavior)
' Show fields and behavior methods on aggregates/entities; hide empty VOs/repos

legend right
  |= Stereotype |= Meaning |
  | <<AggregateRoot>> | Consistency boundary; rich behavior on root |
  | <<Entity>> | Identity + lifecycle; factory + domain methods |
  | <<ValueObject>> | Immutable; equality by value |
  | <<DomainService>> | Stateless domain logic |
  | <<Repository>> | Outbound port (interface in domain/) |
  | | |
  | **Behavior** | Methods reflect live com.ai.*.domain.model |
  | **Preferred Terms** | See docs/Glossary.md |
endlegend

note as N_LAYERS
  controller → service → domain ← infra
  Aggregates encapsulate invariants; application orchestrates use cases.
  ChatMessage bodies persist via Spring AI ChatMemory bridge.
end note

' ── chat ───────────────────────────────────────────────────
package "com.ai.chat.domain" as pkg_chat {
  class ChatSession <<AggregateRoot>> {
    ChatSessionId id
    String clientId
    String title
    --
    {static} create(title, clientId)
    {static} reconstitute(...)
    rename(newTitle)
    addUserMessage(text)
    addAssistantMessage(text)
    getRecentMessages(count)
    clearMessages()
    replaceMessages(messages)
    belongsTo(clientId)
    isEmpty()
  }
  class ChatMessage <<Entity>> {
    MessageId id
    String text
    ChatMessageType messageType
    --
    {static} createUserMessage(text)
    {static} createAssistantMessage(text)
    isFromUser()
    isFromAssistant()
    withText(newText)
  }
  enum ChatMessageType <<ValueObject>> {
    USER
    ASSISTANT
  }
  class WebSource <<ValueObject>> {
    String url
    String title
  }
  interface ChatSessionRepository <<Repository>> {
    save(session)
    findById(id)
  }
  interface ChatWebSourcesRepository <<Repository>> {
    findByContentHash(hash)
  }
}

ChatSession "1" *-- "0..*" ChatMessage
ChatMessage --> ChatMessageType

' ── rag ────────────────────────────────────────────────────
package "com.ai.rag.domain" as pkg_rag {
  class Document <<AggregateRoot>> {
    DocumentId id
    String title
    DocumentStatus status
    --
    markProcessing()
    markReady()
    markFailed()
    updateTitle(newTitle)
  }
  class DocumentChunk <<Entity>> {
    ChunkId id
    DocumentId documentId
    String content
    --
    {static} create(...)
    withEmbedding(vector)
  }
  enum DocumentStatus <<ValueObject>> {
    UPLOADING
    PROCESSING
    READY
    FAILED
  }
  class SourceDocument <<ValueObject>> {
    String text
    double score
  }
  interface IDocumentRepository <<Repository>> {
    save(document)
    findById(id)
  }
}

Document "1" *-- "0..*" DocumentChunk
Document --> DocumentStatus

' ── pipeline + skill ───────────────────────────────────────
package "com.ai.pipeline.domain" as pkg_pipeline {
  class AgentPipeline <<AggregateRoot>> {
    List nodes
    List edges
    --
    {static} create(nodes, edges)
    executionOrder()
  }
  class AgentDefinition <<Entity>> {
    AgentType type
    String systemPrompt
  }
  class SavedWorkflowTemplate <<Entity>> {
    WorkflowTemplateId id
    String name
  }
  interface AgentRegistry <<Repository>> {
    findByType(type)
  }
}

package "com.ai.skill.domain" as pkg_skill {
  class Skill <<AggregateRoot>> {
    SkillId id
    String name
    boolean enabled
    --
    {static} create(...)
    update(name, instructions, tools)
    enable()
    disable()
  }
}

' ── automation ─────────────────────────────────────────────
package "com.ai.automation.domain" as pkg_automation {
  class AutomationSchedule <<AggregateRoot>> {
    ScheduleId id
    ScheduleKind kind
    boolean enabled
    --
    {static} create(...)
    {static} createOnce(...)
    update(...)
    enable(nextRunAt)
    disable()
    markExecuted(finishedAt, nextRunAt)
    completeOnce(finishedAt)
    isOnce()
  }
  class AutomationRun <<Entity>> {
    RunId id
    RunStatus status
  }
  enum RunStatus <<ValueObject>> {
    RUNNING
    SUCCEEDED
    FAILED
  }
}

AutomationSchedule "1" o-- "0..*" AutomationRun

' ── account ────────────────────────────────────────────────
package "com.ai.account.domain" as pkg_account {
  class AccountUser <<Entity>> {
    String provider
    String linkedClientId
    --
    {static} create(provider, subject, email, clientId)
    linkSession(email, clientId)
    unlinkBrowser()
  }
}

' ── mcp ────────────────────────────────────────────────────
package "com.ai.mcp.domain" as pkg_mcp {
  class McpSession <<AggregateRoot>> {
    UUID id
    McpSessionStatus status
    --
    {static} open(serverName, toolCount)
    activate()
    close()
    isActive()
  }
  class McpSessionManager <<DomainService>> {
    register(session)
    close(sessionId)
  }
}

' ── metrics ────────────────────────────────────────────────
package "com.ai.metrics.domain" as pkg_metrics {
  class AiInvocationEvent <<Entity>> {
    AiDomain domain
    InvocationOutcome outcome
    long latencyMs
    --
    {static} builder()
  }
  enum AiDomain <<ValueObject>> {
    CHAT
    RAG
    AGENTS
    TOOLS
    VISION
  }
}

' ── tools (sample) ─────────────────────────────────────────
package "com.ai.tools.domain" as pkg_tools {
  class WeatherReport <<Entity>> {
    String location
    WeatherInfo current
  }
}

' ── cross-cutting VOs ──────────────────────────────────────
package "com.ai.common.domain" as pkg_common {
  class OwnerKey <<ValueObject>> {
    String value
  }
}

ChatSession ..> OwnerKey : owned by
AccountUser ..> OwnerKey : links browser

N_LAYERS .. pkg_chat

@enduml
