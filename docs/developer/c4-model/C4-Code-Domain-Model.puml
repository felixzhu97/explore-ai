@startuml C4-Code-Domain-Model
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}

title Code diagram (C4) — Domain model (by business domain)
hide empty members

legend right
  |= Stereotype |= Meaning |
  | <<Abstract>> | 抽象基类 |
  | <<AggregateRoot>> | 聚合根 |
  | <<Entity>> | 实体 |
  | <<ValueObject>> | 值对象 |
  | <<Enum>> | 枚举 |
  | <<DomainEvent>> | 领域事件 |
  | <<Repository>> | 仓储 / 网关端口 |
endlegend

note as N_LAYERS
  controller → service → domain ← infra
  domain = model (entities, aggregates, value objects, events)
  + repository (persistence and gateway ports) only.
  JPA repositories extend Spring Data Repository<T, ID>;
  owner isolation is an explicit OwnerKey query argument.
  LLM tools and workflows are application ports in service.
  Rule violations raise DomainException(kind, code).
  Aggregates encapsulate invariants; application orchestrates use cases.
  ChatMessage bodies persist via Spring AI ChatMemory bridge.
  Kernel: Domain Kernel + Common packages below.
  Preferred Terms: docs/Glossary.md
end note

' ── Domain Kernel ──────────────────────────────────────────
package "Domain Kernel" as pkg_base {
  class AbstractEmbeddable <<Abstract>> {
    implements Serializable
  }
  class TypedId <<ValueObject>> {
    @Embeddable Lombok class, e.g. ScheduleId
    +value: UUID
    --
    +{static} generate()
    +{static} of(text)
  }
  class AbstractImmutable <<Abstract>> {
    implements Persistable, Serializable
    +id: IdT
    +createdAt: Instant @CreationTimestamp
    --
    +isNew(): Persistable
  }
  class AbstractEntity <<Abstract>> {
    +updatedAt: Instant @UpdateTimestamp
    +version: Long
  }
}

AbstractEmbeddable <|-- TypedId
AbstractImmutable <|-- AbstractEntity
TypedId --> AbstractImmutable : embedded id

' ── Common (owner-aware bases) ─────────────────────────────
package "Common" as pkg_common_kernel {
  class AbstractOwnerAwareImmutable <<Abstract>> {
    +ownerKey: OwnerKey NOT NULL
    --
    +getOwnerKeyValue()
  }
  class AbstractOwnerAwareEntity <<Abstract>> {
    +ownerKey: OwnerKey NOT NULL
    --
    +getOwnerKeyValue()
  }
  class AbstractEnableableNamedOwnerEntity <<Abstract>> {
    +name: String
    +enabled: boolean
    --
    +rename(name)
    +disable()
  }
  class AbstractEnableableDescribedOwnerEntity <<Abstract>> {
    +description: String
    --
    +updateDescription(text)
    +enable()
    +updateEnabledState(enabled)
  }
  class OwnerKey <<ValueObject>> {
    +value: String
    --
    +{static} forClient(id)
    +{static} forAccount(id)
    +isClient()
    +isAccount()
    +requireMergeableInto(target)
  }
  interface OwnerScopedRepository<E, I> <<Repository>> {
    @NoRepositoryBean extends Repository<E, I>
    --
    +save(entity)
    +findByIdAndOwnerKey(id, ownerKey)
    +findAllByOwnerKeyOrderByNameAsc(ownerKey)
    +deleteByIdAndOwnerKey(id, ownerKey)
    +existsByOwnerKeyAndNameIgnoringId(ownerKey, name, excludeId)
  }
}

AbstractImmutable <|-- AbstractOwnerAwareImmutable
AbstractEntity <|-- AbstractOwnerAwareEntity
AbstractOwnerAwareEntity <|-- AbstractEnableableNamedOwnerEntity
AbstractEnableableNamedOwnerEntity <|-- AbstractEnableableDescribedOwnerEntity
AbstractOwnerAwareEntity --> OwnerKey
AbstractOwnerAwareImmutable --> OwnerKey

' ── chat ───────────────────────────────────────────────────
package "Chat" as pkg_chat {
  class ChatSession <<AggregateRoot>> {
    +id: ChatSessionId
    +ownerKey: OwnerKey
    +title: SessionTitle
    +lastActivityAt: Instant
    --
    +{static} create(title, ownerKey)
    +{static} startDefault(ownerKey)
    +{static} startWithId(id, ownerKey)
    +rename(newTitle)
    +needsGeneratedTitle()
    +applyGeneratedTitle(title)
    +restoreMessages(messages)
    +recordExchange(messages)
    +lastAssistantMessage(): Optional
    +firstUserMessage(): Optional
    +isInactiveSince(cutoff)
    +isEmpty()
  }
  class SessionTitle <<ValueObject>> {
    +value: String
    --
    +{static} DEFAULT
    +{static} createTitle(text)
    +{static} createTitleFromFirstMessage(text)
    +{static} createGeneratedTitle(modelTitle)
    +isDefault()
  }
  class ChatMessage <<Entity>> {
    +id: MessageId
    +text: String
    +role: MessageRole
    --
    +{static} restoreMessage(id, text, role, timestamp)
    +isFromUser()
    +isFromAssistant()
  }
  enum MessageRole <<Enum>> {
    USER
    ASSISTANT
  }
  class WebSource <<ValueObject>> {
    +url: String
    +title: String
  }
  class DetectedLanguage <<ValueObject>> {
    +code: String
    --
    +{static} of(text)
  }
  interface ChatSessionRepository <<Repository>> {
    +save(session)
    +findById(id)
    +findByIdAndOwnerKey(id, ownerKey)
  }
  interface ChatWebSourcesRepository <<Repository>> {
    +findByConversationId(conversationId)
  }
}

ChatSession "1" *-- "0..*" ChatMessage
ChatSession --> SessionTitle
ChatMessage --> MessageRole

' ── rag ────────────────────────────────────────────────────
package "RAG" as pkg_rag {
  class RagDocument <<AggregateRoot>> {
    +id: DocumentId
    +ownerKey: OwnerKey
    +title: String
    +status: DocumentStatus
    +chunkCount: int
    --
    +{static} startIngestion(title, fileName, fileSize, ownerKey)
    +completeIngestion(chunkCount)
    +failIngestion()
    +createChunk(index, content, sourceMetadata)
    +isSearchable()
  }
  class DocumentChunk <<Entity>> {
    +id: ChunkId
    +documentId: DocumentId
    +ownerKey: OwnerKey
    +content: String
    --
    +{static} create(...)
    +copyWithEmbedding(vector)
    +calculateSimilarity(queryVector)
    +getExcerpt()
  }
  class ScoredChunk <<ValueObject>> {
    +chunk: DocumentChunk
    +score: double
    --
    +meetsThreshold(threshold)
  }
  enum DocumentStatus <<Enum>> {
    PROCESSING
    READY
    FAILED
  }
  class SourceCitation <<ValueObject>> {
    +content: String
    +score: double
  }
  interface DocumentRepository <<Repository>> {
    +save(document)
    +findByIdAndOwnerKey(id, ownerKey)
  }
}

RagDocument "1" *-- "0..*" DocumentChunk
RagDocument --> DocumentStatus
ScoredChunk --> DocumentChunk

' ── pipeline + skill ───────────────────────────────────────
package "Pipeline" as pkg_pipeline {
  class AgentPipeline <<AggregateRoot>> {
    +nodes: List
    +edges: List
    --
    +{static} create(nodes, edges)
    +executionOrder()
  }
  class AgentDefinition <<Entity>> {
    +type: AgentType
    +systemPrompt: String
  }
  class PipelineNode <<ValueObject>> {
    +agentType: AgentType
    --
    +buildDefinition(fallback)
  }
  class PipelineTemplate <<Entity>> {
    +id: PipelineTemplateId
    +name: String
    +agentTypes: List (workers only)
    --
    +isRunnable()
    +buildLinearPipeline()
    +composeFirstMessage(scheduleBrief)
  }
  class CustomAgent <<Entity>> {
    +id: CustomAgentId
    +agentType: String
    --
    +hasAgentType(agentType)
    +buildAgentDefinition()
  }
  interface PipelineTemplateRepository <<Repository>> {
  }
  interface CustomAgentRepository <<Repository>> {
    +findAllByOwnerKeyAndEnabledTrueOrderByNameAsc(ownerKey)
  }
  interface AgentRegistry <<Repository>> {
    +listBuiltins(language)
    +listAll(ownerKey, language)
  }
}

package "Skill" as pkg_skill {
  class Skill <<AggregateRoot>> {
    +id: SkillId
    +name: String
    +enabled: boolean
    --
    +{static} create(...)
    +update(name, instructions, tools)
    +updateEnabledState(enabled)
    +toPromptSection()
  }
  interface SkillRepository <<Repository>> {
    +findEnabledByOwnerKeyAndIds(ownerKey, ids)
  }
}

' ── automation ─────────────────────────────────────────────
package "Automation" as pkg_automation {
  class AutomationSchedule <<AggregateRoot>> {
    @DynamicUpdate
    +id: ScheduleId
    +timing: ScheduleTiming
    +pipelineTemplateId: PipelineTemplateId
    +enabled: boolean
    --
    +{static} create(...)
    +{static} createOnce(...)
    +update(...)
    +turnOn(now)
    +disable()
    +hasPendingRun(now)
    +pendingRunAt(): Optional
    +provisionalNextRunAt(now)
    +recordRunFinished(finishedAt)
    +resultEmail(textBody, htmlBody)
    +isOnce()
  }
  class ScheduleTiming <<ValueObject>> {
    +kind: ScheduleKind
    +cronExpression: String
    +timezone: String
    --
    +{static} cron(expression, timezone)
    +{static} once(timezone)
    +nextRunAfter(after): Instant
  }
  class AutomationRun <<Entity>> {
    @DynamicUpdate
    +id: RunId
    +ownerKey: OwnerKey
    +status: RunStatus
    +startedAt: Instant
    +finishedAt: Instant
    --
    +{static} start(scheduleId, ownerKey, startedAt)
    +markSucceeded(excerpt, emailStatus)
    +markFailedBeforeEmail(error)
    +markSkippedForQuota()
  }
  enum RunStatus <<Enum>> {
    SUCCESS
    FAILED
    SKIPPED
  }
}

AutomationSchedule "1" o-- "0..*" AutomationRun
AutomationSchedule --> ScheduleTiming : next run from

' ── account ────────────────────────────────────────────────
package "Account" as pkg_account {
  class Account <<Entity>> {
    +provider: String <<NaturalId>>
    +subject: String <<NaturalId>>
    +email: ContactEmail
    +displayName: String
    +linkedClientId: ClientId
    --
    +{static} create(identity, email, displayName)
    +getIdentity(): ExternalIdentity
    +linkBrowser(clientId, email, displayName)
    +recordSignIn(email, displayName)
    +unlinkBrowser()
    +createOwnerKey()
    +guestOwnerKey(): Optional
    +displayLabel(): Optional
  }
  class ExternalIdentity <<ValueObject>> {
    +provider: String
    +subject: String
    --
    +{static} of(provider, subject)
    +{static} iam(subject)
  }
  class ContactEmail <<ValueObject>> {
    +value: String
    --
    +{static} ofNullable(raw)
  }
  class ClientId <<ValueObject>> {
    +value: String (UUID)
    --
    +{static} parse(raw)
    +{static} isValid(raw)
  }
}

Account --> ExternalIdentity : identified by
Account --> ContactEmail
Account --> ClientId : linked browser

' ── billing ────────────────────────────────────────────────
package "Billing" as pkg_billing {
  enum Plan <<Enum>> {
    FREE
    PRO
  }
  class QuotaPolicy <<ValueObject>> {
    +enforced: boolean
    +plan: Plan
    --
    +dailyLimit()
    +ipDailyLimit()
    +globalDailyLimit(): OptionalInt
  }
  class DailyUsage <<ValueObject>> {
    +day: LocalDate
    +count: int
    --
    +{static} none(day)
    +remaining(limit, today)
    +consume(today)
    +release(today)
  }
  class QuotaSubject <<ValueObject>> {
    +key: String
    --
    +{static} owner(ownerKey)
    +{static} address(ip)
    +{static} GLOBAL
  }
  class QuotaDecision <<ValueObject>> {
    +allowed: boolean
    +plan: Plan
    +limit: int
    +remaining: int
    --
    +{static} allow(plan, limit, remaining)
    +{static} refuse(plan, limit)
  }
}

QuotaPolicy --> Plan
QuotaDecision --> Plan

' ── mcp ────────────────────────────────────────────────────
package "MCP" as pkg_mcp {
  class McpSession <<AggregateRoot>> {
    +id: UUID
    +status: McpSessionStatus
    --
    +{static} open(serverName, toolCount)
    +activate()
    +close()
    +isActive()
  }
}

' ── metrics ────────────────────────────────────────────────
package "Metrics" as pkg_metrics {
  class AiInvocationEvent <<DomainEvent>> {
    @Immutable
    +capability: AiCapability
    +outcome: InvocationOutcome
    +ownerKey: OwnerKey (required at creation)
    +latencyMs: long
    --
    +{static} createSucceededEvent(capability, operation, latency, ownerKey)
    +{static} createFailedEvent(capability, operation, latency, ownerKey, error)
  }
  class Latency <<ValueObject>> {
    +millis: long
    --
    +{static} measureSince(startNanos)
  }
  class ErrorSummary <<ValueObject>> {
    +code: String
    +message: String
    --
    +{static} createSummary(throwable)
  }
  class TokenUsage <<ValueObject>> {
    +prompt: Integer
    +completion: Integer
    --
    +calculateTotal()
  }
  class InvocationStats <<ValueObject>> {
    +requests: long
    +errors: long
    --
    +calculateErrorRate()
    +calculateSuccessRate()
  }
  class MetricsWindow <<ValueObject>> {
    +{static} parseWindow(range)
    +from(now)
  }
  class LatencyStats <<ValueObject>> {
    +{static} calculateStats(latencies)
  }
  enum AiCapability <<Enum>> {
    CHAT
    RAG
    AGENTS
    TOOLS
    VISION
    WORKFLOW
  }
}

' ── tools (sample) ─────────────────────────────────────────
package "Tool Calling" as pkg_tools {
  class WeatherSimulator <<Entity>> {
    +location: String
    +current: WeatherInfo
  }
}

' ── cross-cutting (kernel note) ─────────────────────────────
note as KERNEL_NOTE
  OwnerKey and owner-aware entity bases live in
  the **Common** package above.
  Value objects and attribute converters (OwnerKey, enums, JSON lists)
  live in domain.model next to the entities that use them.
  Typed ids are @Embeddable Lombok classes on AbstractEmbeddable,
  mapped to native UUID columns.
  Owner-scoped repository methods take the OwnerKey explicitly
  (findByIdAndOwnerKey, deleteByIdAndOwnerKey); services own
  the @Transactional boundary.
  Default JPA snake_case naming; no @Table/@Column(name=) in domain.
end note

AbstractOwnerAwareEntity <|-- ChatSession : metadata only
AbstractOwnerAwareEntity <|-- RagDocument
AbstractEnableableDescribedOwnerEntity <|-- Skill
AbstractEnableableDescribedOwnerEntity <|-- PipelineTemplate
AbstractEnableableDescribedOwnerEntity <|-- CustomAgent
AbstractEnableableNamedOwnerEntity <|-- AutomationSchedule
AbstractOwnerAwareImmutable <|-- AutomationRun
AbstractEntity <|-- Account
AbstractOwnerAwareImmutable <|-- AiInvocationEvent

OwnerScopedRepository <|-- SkillRepository
OwnerScopedRepository <|-- PipelineTemplateRepository

ChatSession ..> OwnerKey : owned by
RagDocument ..> OwnerKey : owned by
Skill ..> OwnerKey : owned by
Account ..> OwnerKey : links browser
AiInvocationEvent ..> OwnerKey : attributed to
AutomationSchedule ..> PipelineTemplate : by id (PipelineTemplateId)
AiInvocationEvent --> Latency
AiInvocationEvent --> ErrorSummary
AiInvocationEvent --> TokenUsage
PipelineTemplate ..> AgentPipeline : builds linear
CustomAgent ..> AgentDefinition : overrides builtin

N_LAYERS .. pkg_chat
N_LAYERS .. pkg_base
N_LAYERS .. pkg_common_kernel
KERNEL_NOTE .. pkg_common_kernel

@enduml
