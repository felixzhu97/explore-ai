@startuml C4-Deployment
' Theme before C4 includes; do not combine with !NEW_C4_STYLE=1
!theme C4_blue_new from https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/themes
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml

title Deployment (C4) — local/dev + production (single view)

Person_Ext(user, "User / Developer", "Browser or iOS Simulator")

' ── Local / dev ─────────────────────────────────────────────
Deployment_Node(dev, "Developer workstation", "local/dev") {
    Deployment_Node(browser, "Browser", "Chrome / Safari") {
        Container(angular_dev, "Web Frontend", "Angular ng serve", ":4200; proxy /api → :9000")
    }
    Deployment_Node(sim, "iOS Simulator", "Xcode") {
        Container(ios_dev, "AI iOS", "SwiftUI", "PKCE → IAM; Bearer → :9000")
    }
    Deployment_Node(jvm, "JVM", "JDK 25 / Gradle") {
        Container(backend_dev, "AI Platform Backend", "Spring Boot 4.1", ":9000 · IAM JWT RS")
        Container(iam_dev, "Explore IAM", "Spring Boot", ":9100 · OIDC Provider")
        ContainerDb(h2_dev, "H2 Embedded", "file DB", "./data/explore-ai")
        ContainerDb(vision_models, "Image Analysis Models", "ONNX + tessdata", "models/")
    }
    Deployment_Node(local_ai, "Local AI (dev)", "optional") {
        Container_Ext(ollama, "Ollama", "embed + vision", ":11434")
        Container_Ext(speech, "explore-ml speech", "Qwen3-ASR + TTS", ":8004")
        Container_Ext(tesseract, "Tesseract", "OCR", "native")
    }
}

' ── Production (cloud-minimal) ─────────────────────────────
Deployment_Node(prod, "Production", "Vercel + Render Starter") {
    Deployment_Node(vercel, "Vercel", "CDN + build") {
        Container(angular_static, "Web Frontend", "Angular static SPA", "HTTPS")
    }
    Deployment_Node(render, "Render Starter", "Docker / JRE 25") {
        Container(backend_prod, "AI Platform Backend", "Spring Boot prod", ":8080")
        ContainerDb(h2_prod, "H2 File DB", "ephemeral", "/app/data/explore-ai")
    }
}

' ── External (dev + prod) ───────────────────────────────────
Deployment_Node(cloud, "External services", "HTTPS") {
    System_Ext(deepseek, "DeepSeek API", "LLM")
    System_Ext(openai, "OpenAI API", "DALL-E + TTS")
    System_Ext(serper, "Serper.dev", "Web search")
    System_Ext(resend, "Resend", "Automations email (prod)")
    System_Ext(launchdarkly, "LaunchDarkly", "Feature flags")
    System_Ext(datadog, "Datadog us5", "RUM (browser, optional)")
}

Rel(user, angular_dev, "Uses UI", "HTTP :4200")
Rel(user, ios_dev, "Uses app", "Simulator")
Rel(angular_dev, backend_dev, "REST / SSE / WS", "HTTP :9000")
Rel(ios_dev, iam_dev, "OIDC + PKCE", "HTTP :9100")
Rel(ios_dev, backend_dev, "Bearer API", "HTTP :9000")
Rel(backend_dev, iam_dev, "JWKS validate", "HTTP :9100")
Rel(backend_dev, h2_dev, "JDBC")
Rel(backend_dev, vision_models, "Load models", "file I/O")
Rel(backend_dev, ollama, "Embed / vision RAG", "HTTP :11434")
Rel(backend_dev, speech, "Streaming ASR / TTS", "HTTP/WS :8004")
Rel(backend_dev, tesseract, "OCR", "JNA")

Rel(user, angular_static, "Uses UI", "HTTPS")
Rel(angular_static, backend_prod, "same-origin /api rewrite", "HTTPS/SSE/WSS")
Rel(angular_static, launchdarkly, "Client SDK", "HTTPS")
Rel(angular_static, datadog, "RUM", "HTTPS")
Rel(backend_prod, h2_prod, "JDBC")
Rel(backend_prod, launchdarkly, "Server SDK", "HTTPS")

Rel(backend_dev, deepseek, "LLM", "HTTPS")
Rel(backend_dev, openai, "Image + TTS", "HTTPS")
Rel(backend_dev, serper, "searchWeb", "HTTPS")
Rel(backend_prod, deepseek, "LLM", "HTTPS")
Rel(backend_prod, openai, "Image + TTS", "HTTPS")
Rel(backend_prod, serper, "searchWeb", "HTTPS")
Rel(backend_prod, resend, "Automation mail", "HTTPS")

note right of prod
  **cloud-minimal prod**
  · Vercel: https://www.felixzhu.chat
  · Render: explore-ai :8080 (512MB, no javaagent)
  · **On**: module-pipelines / module-skills
  · **Off**: Vision / ASR / MCP / Eval / Ollama
  · Docker bootJar -PcloudMinimal (no ONNX/Tess4J/MCP jars)
  · Automations due-scan off by default
  · H2 ephemeral — restart clears data
end note

SHOW_LEGEND()
@enduml
