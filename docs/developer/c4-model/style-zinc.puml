' Shared look for Code domain model + Dynamic sequence diagrams.
' Do NOT use with structural C4 New Style diagrams (C1–C3 / Deployment).
' White body + colored header/border (IAM / authorization domain model style).

!theme plain

skinparam backgroundColor #FAFAFA
skinparam defaultFontColor #52525B
skinparam arrowColor #A1A1AA
skinparam arrowFontColor #71717A
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 42
skinparam ranksep 52
skinparam roundcorner 12

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
  FontColor #334155
  FontSize 12
  AttributeFontSize 11
  BorderThickness 1.5
}

skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #71717A
  HeaderFontColor #52525B
  FontColor #334155
  FontStyle italic
  BorderThickness 1.5
}

skinparam enum {
  BackgroundColor #FFFFFF
  HeaderFontColor #78350F
  BorderColor #F59E0B
  FontColor #334155
  BorderThickness 1.5
}

skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #E4E4E7
  FontColor #3F3F46
  FontStyle bold
}

skinparam note {
  BackgroundColor #F8FAFC
  BorderColor #CBD5E1
  FontColor #334155
  FontSize 11
}

skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #E4E4E7
  FontColor #3F3F46
}

