@startuml C3-Component
!theme C4_blue_new from https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/themes
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Component Diagram (C3) — AI Platform (backend + frontend)

Container_Boundary(web_app, "Web App (Angular 22)") {
    Component(layout, "MainLayout + app.routes", "Angular", "layout/ · lazy <context>/<context>.routes.ts")
    Component(chat_page, "ChatPageComponent", "Angular", "/chat/:sessionId · sessions + tools")
    Component(rag_page, "RagPageComponent", "Angular", "/rag · document rail + grounded SSE")
    Component(generate_page, "GeneratePageComponent", "Angular", "/generate/image /generate/tts")
    Component(metrics_page, "Metrics pages", "Angular", "/metrics overview + domain drilldown")
    Component(lab_pages, "Lab pages [flag]", "Angular", "/pipelines /automations /vision /mcp /eval /speech-to-text")
    Component(chat_shell, "chat-shell", "Angular", "chat-shell/ · message-pane / sender-bar / bubble-list / markdown / mermaid / A2UI")
    Component(shared_ui, "ui kit", "Angular", "ui/ · zard components · notifications · image zoom")
    Component(api_layer, "Feature services", "Angular", "<context>/<context>.service.ts · ChatService / RagService / ImageService / MetricsService / PipelinesService")
    Component(sse_client, "sse-client", "Utility", "http/ · streamSsePost / parseSseToken")
    Component(flags, "FeatureFlagService + guards", "Angular", "LaunchDarkly Client SDK")
    Component(rum, "datadog-rum.config", "Config", "privacy/ · RUM + ErrorHandler")
}

Container_Boundary(backend, "AI Platform Backend (Spring Boot)") {
    Component(chat_web, "Chat + ChatStream", "controller", "/api/chat/sessions /api/chat/stream SSE")
    Component(rag_web, "RagController", "controller", "/api/rag/*")
    Component(pipeline_web, "Pipeline + Automation", "controller", "/api/pipelines /api/automations")
    Component(agent_web, "Agent façade + A2A", "controller", "/api/agents · /.well-known/agent-card.json · /a2a/v1")
    Component(tools_web, "Tools + Text Analysis + Eval", "controller", "/api/tools /api/text-analysis /api/eval")
    Component(media_web, "Image + Vision + Audio", "controller", "/api/images /api/vision /ws/audio")
    Component(mcp_web, "MCP", "controller", "/api/mcp /api/mcp/client")
    Component(metrics_web, "Metrics + Account + Privacy", "controller", "/api/metrics /api/account /api/privacy")
    Component(security, "Filters + OwnerContext", "web", "CSRF · Bearer CSRF skip · quota · module flags · OwnerKey")
    Component(iam_rs, "IamResourceServerConfig", "security", "oauth2-resource-server · SupplierJwtDecoder · JWT→AccountUser")
    Component(scim_web, "SCIM Users + discovery", "controller", "/scim/v2/Users · ServiceProviderConfig · ResourceTypes · Schemas")
    Component(scim_sec, "ScimSecurityConfig", "security", "@Order(0) · Bearer SCOPE_write:ai_scim · SCIM error bodies")
    Component(scim_app, "ScimAccountService", "service", "Provisioned Account CRUD · If-Match → 412 · DELETE → OwnerErasureService")

    Component(chat_app, "Chat + RAG services", "service", "ChatService / RagChatService / DocumentUploadService / DocumentSearchService")
    Component(pipeline_app, "Pipeline + Automation", "service", "PipelineService / PipelineOrchestrationService / PipelineTemplateService / AutomationService")
    Component(agent_app, "Agent + A2A", "service", "AgentService / A2aService")
    Component(media_app, "Media + Tools + MCP", "service", "ImageGenerationService / VisionAnalysisService / AudioService / ToolService / McpService")
    Component(platform_app, "Platform cross-cut", "service", "FeatureFlagService / MetricsService / AccountService / OwnerErasureService / AiInvocationRecorder / InvocationEventEraser")

    Component(chat_dom, "chat domain", "domain", "ChatSession · ChatMessage · repositories")
    Component(rag_dom, "rag domain", "domain", "RagDocument · DocumentChunk · ETL gateways")
    Component(pipeline_dom, "pipeline + skill", "domain", "AgentPipeline · SavedAgent · PipelineTemplate · Skill")
    Component(agent_dom, "agent + a2a", "domain", "AgentRun · AgentCard · A2aTask · A2aMessage · A2aSkill")
    Component(platform_dom, "metrics + automation + mcp + account", "domain", "AiInvocationEvent · AutomationSchedule · McpSession · Account (userName, active)")

    Component(chat_infra, "chat infra", "infra", "JPA session metadata + ChatMemory")
    Component(rag_infra, "rag infra", "infra", "H2 vector · ETL · Ollama embed")
    Component(pipeline_infra, "pipeline infra", "infra", "Agent registry · Supervisor · Worker invoker · JPA skills / templates")
    Component(platform_infra, "platform infra", "infra", "LaunchDarkly · Resend · JPA events + JDBC drill-down · prompts")
}

Container_Boundary(ios_native, "AI iOS (src/main/ios)") {
    Component(ios_auth, "AuthService + Keychain", "Swift", "PKCE · ASWebAuthenticationSession · tokens")
    Component(ios_ui, "LoginView / HomeView", "SwiftUI", "Sign in → GET /api/account/me → Home")
    Component(ios_api, "APIClient", "URLSession", "Authorization: Bearer")
}

System_Ext(deepseek, "DeepSeek API", "LLM")
System_Ext(openai, "OpenAI API", "DALL-E + TTS")
System_Ext(h2, "H2 Embedded", "JDBC + vectors")
System_Ext(ollama, "Ollama [local]", ":11434")
System_Ext(serper, "Serper.dev", "Web search")
System_Ext(launchdarkly, "LaunchDarkly", "Feature flags")
System_Ext(explore_iam, "Explore IAM", "OIDC / JWKS :9100")

Rel(layout, chat_page, "/chat")
Rel(layout, rag_page, "/rag")
Rel(layout, generate_page, "/generate")
Rel(layout, metrics_page, "/metrics")
Rel(layout, lab_pages, "flag routes")
Rel(chat_page, chat_shell, "Embeds")
Rel(rag_page, chat_shell, "Embeds")
Rel(chat_page, api_layer, "Calls")
Rel(rag_page, api_layer, "Calls")
Rel(generate_page, api_layer, "Calls")
Rel(metrics_page, api_layer, "Calls")
Rel(lab_pages, api_layer, "Calls")
Rel(api_layer, sse_client, "SSE")
Rel(layout, flags, "moduleEnabledGuard")
Rel(api_layer, rum, "errors")

Rel(api_layer, chat_web, "REST / SSE", "/api/chat")
Rel(api_layer, rag_web, "REST / SSE", "/api/rag")
Rel(api_layer, pipeline_web, "REST / SSE", "/api/pipelines /api/automations")
Rel(api_layer, agent_web, "REST / SSE", "/api/agents /a2a/v1")
Rel(api_layer, tools_web, "HTTP", "/api/tools /api/text-analysis /api/eval")
Rel(api_layer, media_web, "HTTP / WS", "/api/images /api/vision /ws/audio")
Rel(api_layer, mcp_web, "HTTP", "/api/mcp")
Rel(api_layer, metrics_web, "HTTP", "/api/metrics /api/account")
Rel(flags, launchdarkly, "Client SDK", "HTTPS")

Rel(ios_ui, ios_auth, "Sign in")
Rel(ios_auth, explore_iam, "authorize + token PKCE", "HTTPS")
Rel(ios_ui, ios_api, "Authenticated calls")
Rel(ios_api, metrics_web, "Bearer GET /api/account/me", "HTTPS")
Rel(ios_api, chat_web, "Bearer API", "HTTPS")

Rel(chat_web, security, "Filters")
Rel(security, iam_rs, "JWT resource server")
Rel(iam_rs, explore_iam, "JWKS", "HTTPS")
Rel(explore_iam, scim_web, "SCIM push", "HTTPS /scim/v2/Users")
Rel(scim_sec, scim_web, "Guards")
Rel(scim_sec, iam_rs, "IAM JWT converter")
Rel(scim_web, scim_app, "Delegates")
Rel(scim_app, platform_dom, "Account lifecycle")
Rel(scim_app, platform_app, "Owner erasure on DELETE")
Rel(chat_web, chat_app, "Delegates")
Rel(rag_web, chat_app, "Delegates")
Rel(pipeline_web, pipeline_app, "Delegates")
Rel(agent_web, agent_app, "Delegates")
Rel(agent_app, pipeline_app, "Worker invoke")
Rel(agent_app, agent_dom, "Uses")
Rel(agent_app, pipeline_infra, "AgentRegistry for Card")
Rel(tools_web, media_app, "Delegates")
Rel(media_web, media_app, "Delegates")
Rel(mcp_web, media_app, "Delegates")
Rel(metrics_web, platform_app, "Delegates")
Rel(platform_app, chat_app, "OwnerErasureRequestedEvent · GuestLinkedToAccountEvent", "sync domain event")
Rel(platform_app, pipeline_app, "OwnerErasureRequestedEvent · GuestLinkedToAccountEvent", "sync domain event")
Rel(chat_app, platform_app, "AiInvocationCompleted/FailedEvent · ChatSessionsErasedEvent", "sync domain event")
Rel(pipeline_app, platform_app, "AiInvocationCompleted/FailedEvent", "sync domain event")
Rel(media_app, platform_app, "AiInvocationCompleted/FailedEvent", "sync domain event")

Rel(chat_app, chat_dom, "Uses")
Rel(chat_app, rag_dom, "Uses")
Rel(pipeline_app, pipeline_dom, "Uses")
Rel(pipeline_app, platform_dom, "Uses")
Rel(media_app, platform_dom, "Uses")
Rel(platform_app, platform_dom, "Uses")

Rel(chat_app, chat_infra, "Ports")
Rel(chat_app, rag_infra, "Ports")
Rel(pipeline_app, pipeline_infra, "Ports")
Rel(platform_app, platform_infra, "Ports")
Rel(media_app, chat_infra, "Ports")
Rel(media_app, rag_infra, "Ports")
Rel(media_app, platform_infra, "Ports")

Rel(chat_infra, h2, "JPA / JDBC")
Rel(rag_infra, h2, "JDBC + vector")
Rel(rag_infra, ollama, "Embed / vision", "HTTP")
Rel(platform_infra, h2, "JDBC metrics")
Rel(platform_infra, launchdarkly, "Server SDK", "HTTPS")
Rel(chat_app, deepseek, "LLM", "HTTPS")
Rel(pipeline_infra, deepseek, "Worker / Supervisor", "HTTPS")
Rel(media_app, openai, "Image + TTS", "HTTPS")
Rel(media_app, serper, "searchWeb", "HTTPS")

SHOW_LEGEND()
@enduml
