@startuml C1-Context
!ROUNDED_STYLE=1
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
UpdateElementStyle("person", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_person", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("system", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_system", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("container", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_container", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("component", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_component", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("node", "#FFFFFF", "#000000", "#000000")
UpdateBoundaryStyle("", $bgColor="#FFFFFF", $fontColor="#000000", $borderColor="#000000")
UpdateRelStyle("#000000", "#000000")
skinparam backgroundColor #FFFFFF
skinparam shadowing false

title System Context (C1) - AI Chat & Agent Platform

Person(user, "User", "Chat, RAG, Agent/workflows, image/TTS; optional Vision/MCP/Eval/ASR\nSigns in via Web or AI iOS (IAM PKCE)")
Person(admin, "Admin / Developer", "Eval, text analysis, metrics, feature flags, API integration")

System_Boundary(ai_platform, "AI Chat & Agent Platform") {
    System(frontend, "Web Frontend", "Angular 22 + TypeScript\nVercel (prod) / ng serve :4200 (dev)")
    System(ios_app, "AI iOS", "SwiftUI src/main/ios\nPublic OIDC client explore-ai-ios + PKCE")
    System(backend, "AI Platform Backend", "Spring Boot 4.1 / Java 25 / Spring AI 2.0\nGradle :9000 (dev) / Render :8080 (prod)\nOAuth2 Resource Server (IAM JWT)")
}

System_Ext(explore_iam, "Explore IAM", "OIDC Provider :9100\nDiscovery / authorize / token / JWKS")
System_Ext(launchdarkly, "LaunchDarkly", "Feature flags")
System_Ext(datadog, "Datadog (us5)", "RUM; optional APM")
System_Ext(deepseek_api, "DeepSeek API", "LLM")
System_Ext(openai_api, "OpenAI API", "DALL-E + TTS")
System_Ext(serper_api, "Serper.dev API", "Web search")
System_Ext(resend_api, "Resend", "Automations email")
System_Ext(h2_db, "H2 Embedded", "Sessions + vectors (default)")
System_Ext(ollama, "Ollama [local]", "Embedding + multimodal RAG")
System_Ext(tesseract, "Tesseract OCR [local]", "OCR")
System_Ext(whisper_cpp, "whisper.cpp [local]", "Streaming ASR")
System_Ext(onnx_vision, "Image Analysis ONNX [local]", "Caption / Detect")

Rel(user, frontend, "Uses Web UI", "HTTPS")
Rel(user, ios_app, "Uses native app", "iOS")
Rel(user, explore_iam, "Login / consent", "OIDC / PKCE")
Rel(admin, launchdarkly, "Configure flags", "HTTPS")
Rel(admin, backend, "Eval / analysis / metrics", "HTTPS")
Rel(frontend, backend, "REST / SSE / WebSocket", "HTTPS")
Rel(ios_app, explore_iam, "Authorize + token (PKCE)", "HTTPS")
Rel(ios_app, backend, "API Bearer access_token", "HTTPS :9000")
Rel(backend, explore_iam, "OIDC discovery / JWKS validate", "HTTPS")

Rel(frontend, launchdarkly, "Client SDK", "HTTPS")
Rel(frontend, datadog, "RUM", "HTTPS")
Rel(backend, launchdarkly, "Server SDK", "HTTPS")
Rel(backend, datadog, "APM (optional)", "HTTPS")
Rel(backend, deepseek_api, "LLM", "HTTPS")
Rel(backend, openai_api, "Image + TTS", "HTTPS")
Rel(backend, serper_api, "Web search", "HTTPS")
Rel(backend, resend_api, "Automations mail", "HTTPS")
Rel(backend, h2_db, "JDBC", "embedded")
Rel_Back(backend, ollama, "Embedding + vision RAG [dev]", "HTTP")
Rel_Back(backend, tesseract, "OCR [dev]", "JNA")
Rel_Back(backend, whisper_cpp, "ASR [dev]", "HTTP/WS")
Rel_Back(backend, onnx_vision, "Caption / Detect [dev]", "file I/O")

SHOW_LEGEND()
@enduml
