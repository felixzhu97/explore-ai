@startuml C2-Container
!theme C4_blue_new from https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/themes
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Container Diagram (C2) — AI Platform Backend (13 subdomains)

' ============================================================
' PEOPLE
' ============================================================
Person(user, "用户", "对话、文档、Agent / 工作流、工具、图像分析、语音")
Person(admin, "管理员/开发者", "评估、文本分析、AI 指标看板、功能开关")

' ============================================================
' FRONTEND / NATIVE
' ============================================================
Container(angular_app, "Web Frontend", "Angular 22 + TypeScript", "/chat /generate /rag /metrics + flag: /agents /skills /vision /mcp /eval /speech-to-text\nLaunchDarkly + Datadog RUM")
Container(ios_app, "AI iOS", "SwiftUI", "src/main/ios · PKCE · explore-ai-ios · API :9000")

' ============================================================
' BACKEND
' ============================================================
Container(backend, "AI Platform Backend", "Spring Boot 4.1 / Java 25 / Spring AI 2.0", "Clean Architecture，dev :9000 / prod :8080\nIamResourceServerConfig · JWT → Account")

' ============================================================
' DOMAIN 1: CHAT
' ============================================================
Container_Boundary(chat_domain, "Chat Domain") {
    Container(chat_controller, "ChatController", "@RestController", "/api/chat/sessions, /api/chat/health")
    Container(chat_stream_controller, "ChatStreamController", "@RestController", "/api/chat/providers, /api/chat/models, /api/chat/stream (SSE)")
    Container(chat_service, "ChatService", "Application Service", "Spring AI 对话 + 流式")
    Container(chat_session, "ChatSession", "Aggregate Root", "聊天会话聚合根")
    Container(jdbc_sess_repo, "ChatSessionRepository", "Spring Data JPA", "chat_session 元数据 · 按 OwnerKey 查询")
    Container(jdbc_chat_memory, "JdbcChatMemoryRepository", "Spring AI", "消息记忆 JDBC")
}

' ============================================================
' DOMAIN 2: PIPELINE [flag-guarded]
' ============================================================
Container_Boundary(pipeline_domain, "Pipeline Domain") {
    Container(pipeline_controller, "PipelineController", "@RestController", "/api/pipelines/* (agent-types, invoke/sse)")
    Container(pipeline_template_controller, "PipelineTemplateController", "@RestController", "/api/pipelines/template-definitions + /api/pipelines/templates CRUD")
    Container(pipeline_service, "PipelineService", "Application Service", "Worker / Supervisor / Pipeline 编排入口")
    Container(pipeline_template_service, "PipelineTemplateService", "Application Service", "内置模版定义 + 已保存模版")
    Container(pipeline_template_repo, "PipelineTemplateRepository", "Spring Data JPA", "pipeline_template 表 · 按 OwnerKey 查询")
    Container(orchestration_service, "PipelineOrchestrationService", "Application Service", "编排 Worker 流水线")
    Container(agent_registry, "CatalogAgentRegistry", "@Component", "Agent 注册表")
    Container(supervisor_router, "SpringAiSupervisorRouter", "@Component", "Supervisor 路由")
    Container(worker_invoker, "SpringAiWorkerAgentInvoker", "@Component", "Worker 调用 + DSML 过滤")
}

' ============================================================
' DOMAIN 2b: DEEP AGENT [flag-guarded]
' ============================================================
Container_Boundary(skill_domain, "Skill Domain") {
    Container(skill_controller, "SkillController", "@RestController", "/api/skills CRUD + templates")
    Container(skill_service, "SkillService", "Application Service", "用户 Skill 管理")
    Container(skill_repo, "SkillRepository", "Spring Data JPA", "skill 表 · 按 OwnerKey 查询")
    Container(skill_prompt, "SkillSystemPromptBuilder", "Application", "Chat system 注入 Active Skills")
}

' ============================================================
' DOMAIN 3: RAG (+ ETL)
' ============================================================
Container_Boundary(rag_domain, "RAG Domain") {
    Container(rag_controller, "RagController", "@RestController", "/api/rag/*")
    Container(rag_app_svc, "RagApplicationService", "Application Service", "RAG 门面")
    Container(doc_upload_svc, "DocumentUploadService", "Application Service", "文档上传/列表/删除 (ETL 编排)")
    Container(rag_doc_search, "DocumentSearchService", "Application Service", "向量检索")
    Container(rag_chat_svc, "RagChatService", "Application Service", "RAG 聊天")
    Container(vision_chat_svc, "VisionChatService", "Application Service", "多模态 RAG (Ollama qwen3.5) [local]")
    Container(etl_reader, "PdfAndTextDocumentReader", "@Component", "PDF/TXT 读取")
    Container(etl_transformer, "ChunkingDocumentTransformer", "@Component", "分块转换")
    Container(etl_writer, "EmbeddingDocumentWriter", "@Component", "Embedding 写入")
    Container(h2_vector, "H2DocumentChunkRepository", "@Repository", "H2 向量检索 (默认)")
    Container(ollama_emb, "OllamaTextEmbeddingGateway", "@Component", "qwen3-embedding:0.6b [local]")
}

' ============================================================
' DOMAIN 4: TOOLS
' ============================================================
Container_Boundary(tool_domain, "Tools Domain") {
    Container(tool_controller, "ToolsController", "@RestController", "/api/tools/*")
    Container(tool_service, "ToolService", "Application Service", "工具调用入口")
    Container(weather_tool, "WeatherTools", "*Tool", "天气查询工具")
    Container(web_search_tool, "SerperWebSearchTool", "*Tool", "Web 搜索 (Serper.dev)")
}

' ============================================================
' DOMAIN 5: TEXT ANALYSIS
' ============================================================
Container_Boundary(text_analysis_domain, "Text Analysis Domain") {
    Container(text_analysis_controller, "TextAnalysisController", "@RestController", "/api/text-analysis")
    Container(text_analysis_service, "TextAnalysisService", "Application Service", "结构化文本分析")
}

' ============================================================
' DOMAIN 6: EVAL [flag-guarded]
' ============================================================
Container_Boundary(eval_domain, "Evaluation Domain") {
    Container(eval_controller, "EvalController", "@RestController", "/api/eval/chat")
    Container(eval_svc, "ChatQualityEvaluator", "Domain Service", "LLM-as-a-Judge 质量评估")
}

' ============================================================
' DOMAIN 7: IMAGE
' ============================================================
Container_Boundary(image_domain, "Image Domain") {
    Container(image_controller, "ImageController", "@RestController", "/api/images/*")
    Container(image_service, "ImageGenerationService", "Application Service", "图像生成")
    Container(image_gateway, "SpringAiImageGenerationGateway", "@Component", "OpenAI DALL-E")
}

' ============================================================
' DOMAIN 8: IMAGE ANALYSIS [flag-guarded, local]
' ============================================================
Container_Boundary(vision_domain, "Image Analysis Domain") {
    Container(vision_controller, "VisionController", "@RestController", "/api/vision/{caption,detect,ocr,health}")
    Container(vision_service, "VisionAnalysisService", "Application Service", "Caption / Detect / OCR 编排")
    Container(onnx_captioner, "OnnxBlipCaptioner", "@Service", "BLIP ONNX [local]")
    Container(onnx_detector, "OnnxYoloDetector", "@Service", "YOLOv8 ONNX [local]")
    Container(tess4j_ocr, "Tess4jOcrEngine", "@Service", "Tesseract OCR [local]")
}

' ============================================================
' DOMAIN 9: AUDIO
' ============================================================
Container_Boundary(audio_domain, "Audio Domain") {
    Container(audio_controller, "AudioController", "@RestController", "TTS HTTP + ASR WebSocket")
    Container(audio_service, "AudioService", "Application Service", "TTS")
    Container(transcription_service, "StreamingTranscriptionService", "Application Service", "流式转录")
    Container(asr_ws_handler, "AudioTranscriptionWebSocketHandler", "@Component", "ASR WebSocket")
    Container(transcription_client, "SpeechStreamingTranscriptionClient", "@Component", "explore-ml Qwen3-ASR")
    Container(tts_gateway, "TextToSpeechGateway", "Gateway", "OpenAI TTS or speech Qwen TTS")
}

' ============================================================
' DOMAIN 10: MCP SERVER [flag-guarded]
' ============================================================
Container_Boundary(mcp_server_domain, "MCP Server Domain") {
    Container(mcp_controller, "McpController", "@RestController", "/api/mcp/*")
    Container(mcp_server_svc, "McpServerToolsProvider", "Infrastructure", "MCP Server 工具注册")
}

' ============================================================
' DOMAIN 11: MCP CLIENT [flag-guarded]
' ============================================================
Container_Boundary(mcp_client_domain, "MCP Client Domain") {
    Container(mcp_client_controller, "McpClientController", "@RestController", "/api/mcp/client/*")
    Container(mcp_service, "McpService", "Application Service", "MCP Client 调用入口")
    Container(mcp_client_gateway, "SpringAiMcpClientGateway", "@Component", "MCP Client 连接")
}

' ============================================================
' DOMAIN: METRICS
' ============================================================
Container_Boundary(metrics_domain, "Metrics Domain") {
    Container(metrics_controller, "MetricsController", "@RestController", "/api/metrics/* (overview, capabilities, series, drilldown)")
    Container(metrics_service, "MetricsService", "Application Service", "概览 / 域快照 / 时序 / 下钻")
    Container(invocation_recorder, "AiInvocationRecorder", "Application", "业务路径旁路记录调用事件")
    Container(ai_invocation_event, "AiInvocationEvent", "Entity", "AI 调用事件")
    Container(jdbc_invocation_repo, "JpaAiInvocationEventRepository", "@Repository", "@Immutable 事件 JPA persist · 下钻 JDBC")
    Container(jdbc_metrics_query, "JdbcMetricsQueryRepository", "@Repository", "聚合查询 JDBC")
}

' ============================================================
' CROSS-CUTTING
' ============================================================
Container_Boundary(crosscut, "Cross-Cutting") {
    Container(prompt_catalog, "Prompt Catalog", "classpath:prompts/**", "shared style/GFM + chat/rag/agent/task/guards .st")
    Container(prompt_templates, "PromptTemplates", "@Component", "组合默认 system / Agent / RAG 片段")
    Container(rag_prompt_builder, "LocalizedRagPromptBuilder", "@Component", "RAG/Vision 多语言 user prompt")
    Container(module_filter, "ModuleAccessFilter", "@Component", "按 LaunchDarkly 开关拦截模块 API")
    Container(feature_flag_svc, "FeatureFlagService", "@Service", "模块开关查询")
    Container(ld_repo, "LaunchDarklyFeatureFlagRepository", "@Component", "LaunchDarkly Server SDK")
    Container(ex_handler, "GlobalExceptionHandler", "@RestControllerAdvice", "统一异常处理")
}

' ============================================================
' EXTERNAL SYSTEMS
' ============================================================
ContainerDb(h2_db, "H2 Embedded", "H2 + Liquibase", "会话 + ChatMemory + 向量 + AI 调用事件 (默认)", "内嵌")
Container_Ext(deepseek_api, "DeepSeek API", "REST API", "LLM 对话", "HTTPS")
Container_Ext(openai_api, "OpenAI API", "REST API", "DALL-E + TTS", "HTTPS")
Container_Ext(ollama_svc, "Ollama [local]", "REST API", "Embedding + qwen3.5 多模态 RAG", "11434")
Container_Ext(tesseract_svc, "Tesseract OCR [local]", "Native Library", "eng + chi_sim tessdata", "系统安装")
Container_Ext(speech_svc, "explore-ml speech", "REST/WebSocket", "Qwen3-ASR + Qwen3-TTS", "8000")
Container_Ext(serper_api, "Serper.dev API", "REST API", "Web 搜索", "HTTPS")
Container_Ext(launchdarkly, "LaunchDarkly", "SaaS", "功能开关", "HTTPS")
Container_Ext(datadog, "Datadog us5", "SaaS", "APM (javaagent → Agent)", "HTTPS")
Container_Ext(explore_iam, "Explore IAM", "OIDC Provider", "authorize / token / JWKS :9100", "HTTPS")

' ============================================================
' RELATIONSHIPS
' ============================================================
Rel(user, angular_app, "使用 Web UI", "HTTP/SSE/WebSocket")
Rel(user, ios_app, "使用 iOS", "SwiftUI")
Rel(admin, eval_controller, "质量评估", "HTTP")
Rel(admin, text_analysis_controller, "文本分析", "HTTP")
Rel(admin, metrics_controller, "AI 指标看板", "HTTP")

Rel(ios_app, explore_iam, "OIDC + PKCE", "HTTPS :9100")
Rel(ios_app, backend, "Bearer access_token", "HTTPS :9000")
Rel(backend, explore_iam, "JWKS / issuer validate", "HTTPS")

Rel(angular_app, chat_controller, "会话 CRUD", "HTTP")
Rel(angular_app, chat_stream_controller, "流式对话", "SSE")
Rel(angular_app, pipeline_controller, "工作流画布 [flag]", "SSE")
Rel(angular_app, pipeline_template_controller, "工作流模版 [flag]", "HTTP")
Rel(angular_app, skill_controller, "Skills CRUD [flag]", "HTTP")
Rel(angular_app, rag_controller, "RAG", "HTTP/SSE")
Rel(angular_app, tool_controller, "工具", "HTTP")
Rel(angular_app, image_controller, "图像生成", "HTTP")
Rel(angular_app, vision_controller, "图像分析 [flag]", "HTTP")
Rel(angular_app, audio_controller, "TTS + ASR [flag]", "HTTP/WebSocket")
Rel(angular_app, mcp_controller, "MCP Server [flag]", "HTTP")
Rel(angular_app, mcp_client_controller, "MCP Client [flag]", "HTTP")
Rel(angular_app, metrics_controller, "AI 指标", "HTTP")
Rel(angular_app, launchdarkly, "前端功能开关", "HTTPS")

Rel(chat_controller, chat_service, "调用")
Rel(chat_stream_controller, chat_service, "流式对话")
Rel(chat_stream_controller, skill_repo, "解析 skillIds")
Rel(chat_stream_controller, skill_prompt, "注入 Active Skills")
Rel(skill_controller, skill_service, "调用")
Rel(skill_service, skill_repo, "持久化")
Rel(skill_repo, h2_db, "JDBC")
Rel(chat_service, jdbc_sess_repo, "会话元数据")
Rel(chat_service, jdbc_chat_memory, "消息记忆")
Rel(jdbc_sess_repo, h2_db, "JPA")
Rel(jdbc_chat_memory, h2_db, "JDBC")
Rel(chat_service, deepseek_api, "LLM", "HTTPS")
Rel(chat_service, prompt_templates, "defaultSystem")

Rel(pipeline_controller, pipeline_service, "调用")
Rel(pipeline_template_controller, pipeline_template_service, "调用")
Rel(pipeline_template_service, pipeline_template_repo, "持久化")
Rel(pipeline_template_repo, h2_db, "JDBC")
Rel(pipeline_service, orchestration_service, "编排")
Rel(pipeline_service, agent_registry, "注册表")
Rel(orchestration_service, supervisor_router, "路由")
Rel(orchestration_service, worker_invoker, "Worker")
Rel(agent_registry, prompt_templates, "Agent system prompts")
Rel(worker_invoker, deepseek_api, "LLM", "HTTPS")
Rel(supervisor_router, deepseek_api, "LLM", "HTTPS")


Rel(rag_controller, rag_app_svc, "调用")
Rel(rag_app_svc, doc_upload_svc, "上传/删除")
Rel(rag_app_svc, rag_doc_search, "检索")
Rel(rag_app_svc, rag_chat_svc, "RAG 聊天")
Rel(rag_controller, vision_chat_svc, "视觉聊天 [local]")
Rel(rag_chat_svc, rag_prompt_builder, "user prompt")
Rel(vision_chat_svc, rag_prompt_builder, "user prompt")
Rel(rag_prompt_builder, prompt_templates, "shared style")
Rel(prompt_templates, prompt_catalog, "load .st")
Rel(doc_upload_svc, etl_reader, "ETL")
Rel(doc_upload_svc, etl_transformer, "ETL")
Rel(doc_upload_svc, etl_writer, "ETL")
Rel(rag_doc_search, h2_vector, "向量检索")
Rel(etl_writer, ollama_emb, "Embedding [local]")
Rel(h2_vector, h2_db, "向量存储", "JDBC")
Rel(ollama_emb, ollama_svc, "Embedding", "HTTP")
Rel(vision_chat_svc, ollama_svc, "多模态 RAG", "HTTP")

Rel(vision_controller, vision_service, "调用")
Rel(vision_service, onnx_captioner, "Caption")
Rel(vision_service, onnx_detector, "Detect")
Rel(vision_service, tess4j_ocr, "OCR")
Rel(tess4j_ocr, tesseract_svc, "OCR", "JNA")

Rel(metrics_controller, metrics_service, "调用")
Rel(metrics_service, jdbc_metrics_query, "聚合")
Rel(metrics_service, jdbc_invocation_repo, "下钻")
Rel(invocation_recorder, jdbc_invocation_repo, "写入事件")
Rel(jdbc_invocation_repo, h2_db, "JPA + JDBC")
Rel(jdbc_metrics_query, h2_db, "JDBC")

Rel(tool_controller, tool_service, "调用")
Rel(tool_service, weather_tool, "天气")
Rel(tool_service, rag_doc_search, "RAG 搜索")
Rel(tool_service, web_search_tool, "Web 搜索")
Rel(web_search_tool, serper_api, "搜索", "HTTPS")

Rel(text_analysis_controller, text_analysis_service, "调用")
Rel(text_analysis_service, deepseek_api, "结构化输出", "HTTPS")

Rel(eval_controller, eval_svc, "调用")
Rel(eval_svc, deepseek_api, "LLM 评估", "HTTPS")

Rel(image_controller, image_service, "调用")
Rel(image_service, image_gateway, "生成")
Rel(image_gateway, openai_api, "DALL-E", "HTTPS")

Rel(audio_controller, audio_service, "TTS")
Rel(audio_controller, asr_ws_handler, "ASR WebSocket")
Rel(audio_service, tts_gateway, "合成")
Rel(asr_ws_handler, transcription_service, "流式转录")
Rel(transcription_service, transcription_client, "speech")
Rel(transcription_client, speech_svc, "WS /ws/v1/audios:transcribe", "WS :8000")
Rel(tts_gateway, openai_api, "OpenAI TTS", "HTTPS")
Rel(tts_gateway, speech_svc, "voices:synthesize", "HTTP :8000")

Rel(mcp_controller, mcp_server_svc, "调用")
Rel(mcp_client_controller, mcp_service, "调用")
Rel(mcp_service, mcp_client_gateway, "MCP 连接")

Rel(module_filter, feature_flag_svc, "查询开关")
Rel(feature_flag_svc, ld_repo, "读取")
Rel(ld_repo, launchdarkly, "Server SDK", "HTTPS")
Rel(backend, datadog, "javaagent → Agent → us5", "Private Network / HTTPS")

SHOW_LEGEND()
@enduml
