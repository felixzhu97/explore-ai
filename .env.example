# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
# Default: Qwen3 Embedding 0.6B (1024-d). Pull: ollama pull qwen3-embedding:0.6b
# Re-ingest documents after changing the embedding model (vectors from other models are incompatible).
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Optional larger sizes: qwen3-embedding:4b / qwen3-embedding:8b (update dimensions accordingly)

# DeepSeek API Configuration (for chat, still uses DeepSeek)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Image generation (default: free local Ollama)
# Run: ollama pull x/flux2-klein
IMAGE_PROVIDER=ollama
IMAGE_MODEL=x/flux2-klein
IMAGE_API_KEY=ollama
IMAGE_BASE_URL=http://localhost:11434/v1

# Optional OpenAI DALL-E (set provider=openai)
# OPENAI_API_KEY=your-openai-api-key
# IMAGE_PROVIDER=openai
# IMAGE_MODEL=dall-e-3
# IMAGE_API_KEY=${OPENAI_API_KEY}
# IMAGE_BASE_URL=https://api.openai.com/v1

# Text-to-speech (OpenAI)
# TTS_ENABLED=true
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=alloy
# TTS_API_KEY=${OPENAI_API_KEY}
# TTS_BASE_URL=https://api.openai.com/v1

# Optional Anthropic provider
ANTHROPIC_API_KEY=

# Enable local Ollama chat provider (default: false)
OLLAMA_VISION_ENABLED=true
OLLAMA_VISION_MODEL=qwen3.5:35b

# Enable SimpleLoggerAdvisor for AI request/response logging in non-prod
AI_LOGGING_ADVISOR_ENABLED=true

# LaunchDarkly feature flags (optional)
LAUNCHDARKLY_ENABLED=true
LAUNCHDARKLY_SDK_KEY=
LAUNCHDARKLY_CLIENT_SIDE_ID=

# Datadog RUM (optional; create your own app at https://us5.datadoghq.com/rum/list)
# Vercel build: set DD_APPLICATION_ID + DD_CLIENT_TOKEN (injected by scripts/inject-datadog-env.mjs)
# Render Starter: leave DD_API_KEY and DD_AGENT_HOST unset (no javaagent; still 512MB RAM)
DD_API_KEY=
DD_AGENT_HOST=
DD_TRACE_AGENT_PORT=8126
DD_SITE=us5.datadoghq.com
DD_SERVICE=explore-ai-api
DD_ENV=production
DD_APPLICATION_ID=
DD_CLIENT_TOKEN=

# H2 Database Configuration (optional)
H2_URL=jdbc:h2:file:./data/explore-ai;AUTO_SERVER=TRUE
H2_USER=sa
H2_PASSWORD=

# Serper API Key (web search + citations in chat)
SERPER_API_KEY=your-serper-api-key

# Automations — due scanner (optional)
# APP_AUTOMATION_SCAN_ENABLED=true
# APP_AUTOMATION_SCAN_DELAY_MS=60000
# Local one-shot tests: APP_AUTOMATION_SCAN_DELAY_MS=5000

# Automations email via Resend HTTP API (optional; default disabled = log only)
# APP_MAIL_ENABLED=true
# APP_MAIL_PROVIDER=resend
# APP_MAIL_FROM=onboarding@resend.dev
# APP_MAIL_RESEND_API_KEY=re_xxxxxxxx
# Prod (Render Dashboard Secrets; also declared in render.yaml with sync: false):
#   APP_MAIL_ENABLED=true
#   APP_MAIL_PROVIDER=resend
#   APP_MAIL_FROM=<verified-domain-address>
#   APP_MAIL_RESEND_API_KEY=<resend-api-key>

# Local Fetch MCP (optional): deep-read URLs after search
# Requires uv/uvx: https://docs.astral.sh/uv/
# 1. cp src/main/resources/application-local.yml.example src/main/resources/application-local.yml
# 2. SPRING_PROFILES_ACTIVE=local
# Then Spring starts: uvx mcp-server-fetch