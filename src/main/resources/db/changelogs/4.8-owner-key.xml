<?xml version="1.1" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
  "
>
  <changeSet author="explore-ai" id="20260808-001-rename-client-id-to-owner-key" dbms="h2">
    <sql>
      ALTER TABLE chat_sessions ALTER COLUMN client_id RENAME TO owner_key;
      ALTER TABLE chat_sessions ALTER COLUMN owner_key VARCHAR(80);
      UPDATE chat_sessions SET owner_key = 'c:' || owner_key
        WHERE owner_key IS NOT NULL
          AND owner_key NOT LIKE 'c:%'
          AND owner_key NOT LIKE 'u:%';

      ALTER TABLE skills ALTER COLUMN client_id RENAME TO owner_key;
      ALTER TABLE skills ALTER COLUMN owner_key VARCHAR(80) NOT NULL;
      UPDATE skills SET owner_key = 'c:' || owner_key
        WHERE owner_key NOT LIKE 'c:%' AND owner_key NOT LIKE 'u:%';

      ALTER TABLE pipeline_agents ALTER COLUMN client_id RENAME TO owner_key;
      ALTER TABLE pipeline_agents ALTER COLUMN owner_key VARCHAR(80) NOT NULL;
      UPDATE pipeline_agents SET owner_key = 'c:' || owner_key
        WHERE owner_key NOT LIKE 'c:%' AND owner_key NOT LIKE 'u:%';

      ALTER TABLE workflow_templates ALTER COLUMN client_id RENAME TO owner_key;
      ALTER TABLE workflow_templates ALTER COLUMN owner_key VARCHAR(80) NOT NULL;
      UPDATE workflow_templates SET owner_key = 'c:' || owner_key
        WHERE owner_key NOT LIKE 'c:%' AND owner_key NOT LIKE 'u:%';

      ALTER TABLE automation_schedules ALTER COLUMN client_id RENAME TO owner_key;
      ALTER TABLE automation_schedules ALTER COLUMN owner_key VARCHAR(80) NOT NULL;
      UPDATE automation_schedules SET owner_key = 'c:' || owner_key
        WHERE owner_key NOT LIKE 'c:%' AND owner_key NOT LIKE 'u:%';

      ALTER TABLE automation_runs ALTER COLUMN client_id RENAME TO owner_key;
      ALTER TABLE automation_runs ALTER COLUMN owner_key VARCHAR(80) NOT NULL;
      UPDATE automation_runs SET owner_key = 'c:' || owner_key
        WHERE owner_key NOT LIKE 'c:%' AND owner_key NOT LIKE 'u:%';
    </sql>
  </changeSet>

  <changeSet author="explore-ai" id="20260808-002-reindex-owner-key" dbms="h2">
    <dropIndex tableName="chat_sessions" indexName="idx_chat_sessions_client_id"/>
    <createIndex indexName="idx_chat_sessions_owner_key" tableName="chat_sessions">
      <column name="owner_key"/>
    </createIndex>

    <dropIndex tableName="skills" indexName="idx_skills_client_id"/>
    <createIndex indexName="idx_skills_owner_key" tableName="skills">
      <column name="owner_key"/>
    </createIndex>

    <dropIndex tableName="pipeline_agents" indexName="idx_pipeline_agents_client_id"/>
    <createIndex indexName="idx_pipeline_agents_owner_key" tableName="pipeline_agents">
      <column name="owner_key"/>
    </createIndex>

    <dropIndex tableName="workflow_templates" indexName="idx_workflow_templates_client_id"/>
    <createIndex indexName="idx_workflow_templates_owner_key" tableName="workflow_templates">
      <column name="owner_key"/>
    </createIndex>

    <dropIndex tableName="automation_schedules" indexName="idx_automation_schedules_client_id"/>
    <createIndex indexName="idx_automation_schedules_owner_key" tableName="automation_schedules">
      <column name="owner_key"/>
    </createIndex>

    <dropIndex tableName="automation_runs" indexName="idx_automation_runs_client_id"/>
    <createIndex indexName="idx_automation_runs_owner_key" tableName="automation_runs">
      <column name="owner_key"/>
    </createIndex>
  </changeSet>

  <changeSet author="explore-ai" id="20260808-003-unique-constraints-owner-key" dbms="h2">
    <dropUniqueConstraint tableName="skills" constraintName="uk_skills_client_id_name"/>
    <addUniqueConstraint
      tableName="skills"
      columnNames="owner_key, name"
      constraintName="uk_skills_owner_key_name"/>

    <dropUniqueConstraint tableName="pipeline_agents" constraintName="uk_pipeline_agents_client_id_type_key"/>
    <addUniqueConstraint
      tableName="pipeline_agents"
      columnNames="owner_key, type_key"
      constraintName="uk_pipeline_agents_owner_key_type_key"/>

    <dropUniqueConstraint tableName="workflow_templates" constraintName="uk_workflow_templates_client_id_name"/>
    <addUniqueConstraint
      tableName="workflow_templates"
      columnNames="owner_key, name"
      constraintName="uk_workflow_templates_owner_key_name"/>
  </changeSet>

  <changeSet author="explore-ai" id="20260808-004-documents-owner-key" dbms="h2">
    <addColumn tableName="documents">
      <column name="owner_key" type="${string.type}(80)" defaultValue="c:legacy-orphan">
        <constraints nullable="false"/>
      </column>
    </addColumn>
    <createIndex indexName="idx_documents_owner_key" tableName="documents">
      <column name="owner_key"/>
    </createIndex>
  </changeSet>

  <changeSet author="explore-ai" id="20260808-005-document-chunks-owner-key" dbms="h2">
    <addColumn tableName="document_chunks">
      <column name="owner_key" type="${string.type}(80)" defaultValue="c:legacy-orphan">
        <constraints nullable="false"/>
      </column>
    </addColumn>
    <createIndex indexName="idx_document_chunks_owner_key" tableName="document_chunks">
      <column name="owner_key"/>
    </createIndex>
  </changeSet>

  <changeSet author="explore-ai" id="20260808-006-ai-invocation-events-owner-key" dbms="h2">
    <addColumn tableName="ai_invocation_events">
      <column name="owner_key" type="${string.type}(80)" defaultValue="c:legacy-orphan">
        <constraints nullable="false"/>
      </column>
    </addColumn>
    <createIndex indexName="idx_ai_invocation_events_owner_key" tableName="ai_invocation_events">
      <column name="owner_key"/>
    </createIndex>
  </changeSet>
</databaseChangeLog>
