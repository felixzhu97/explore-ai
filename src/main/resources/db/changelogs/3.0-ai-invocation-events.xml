<?xml version="1.1" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
  "
>
  <changeSet author="explore-ai" id="20260726-001-ai-invocation-events" dbms="h2">
    <createTable tableName="ai_invocation_events">
      <column name="id" type="${uuid.type}">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="occurred_at" type="${date.time.type}">
        <constraints nullable="false"/>
      </column>
      <column name="domain" type="${string.type}(32)">
        <constraints nullable="false"/>
      </column>
      <column name="operation" type="${string.type}(64)">
        <constraints nullable="false"/>
      </column>
      <column name="outcome" type="${string.type}(16)">
        <constraints nullable="false"/>
      </column>
      <column name="latency_ms" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="provider" type="${string.type}(64)"/>
      <column name="model" type="${string.type}(128)"/>
      <column name="session_id" type="${string.type}(36)"/>
      <column name="document_id" type="${string.type}(36)"/>
      <column name="agent_type" type="${string.type}(64)"/>
      <column name="tool_name" type="${string.type}(128)"/>
      <column name="prompt_tokens" type="INT"/>
      <column name="completion_tokens" type="INT"/>
      <column name="error_code" type="${string.type}(64)"/>
      <column name="error_message" type="${string.type}(512)"/>
    </createTable>
    <createIndex indexName="idx_ai_inv_occurred_at" tableName="ai_invocation_events">
      <column name="occurred_at"/>
    </createIndex>
    <createIndex indexName="idx_ai_inv_domain_occurred" tableName="ai_invocation_events">
      <column name="domain"/>
      <column name="occurred_at"/>
    </createIndex>
    <createIndex indexName="idx_ai_inv_session" tableName="ai_invocation_events">
      <column name="session_id"/>
    </createIndex>
    <createIndex indexName="idx_ai_inv_model_occurred" tableName="ai_invocation_events">
      <column name="model"/>
      <column name="occurred_at"/>
    </createIndex>
  </changeSet>
</databaseChangeLog>
