<?xml version="1.1" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
  "
>
  <changeSet author="explore-ai" id="20260806-002-automation-schedules" dbms="h2">
    <createTable tableName="automation_schedules">
      <column name="id" type="${uuid.type}">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="client_id" type="${string.type}(64)">
        <constraints nullable="false"/>
      </column>
      <column name="name" type="${string.type}(120)">
        <constraints nullable="false"/>
      </column>
      <column name="cron_expression" type="${string.type}(80)">
        <constraints nullable="false"/>
      </column>
      <column name="timezone" type="${string.type}(64)">
        <constraints nullable="false"/>
      </column>
      <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
        <constraints nullable="false"/>
      </column>
      <column name="action_type" type="${string.type}(40)">
        <constraints nullable="false"/>
      </column>
      <column name="workflow_template_id" type="${uuid.type}">
        <constraints nullable="false"/>
      </column>
      <column name="recipient_email" type="${string.type}(320)">
        <constraints nullable="false"/>
      </column>
      <column name="brief" type="${clob.type}">
        <constraints nullable="false"/>
      </column>
      <column name="next_run_at" type="${date.time.type}">
        <constraints nullable="false"/>
      </column>
      <column name="last_run_at" type="${date.time.type}"/>
      <column name="created_at" type="${date.time.type}" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
      <column name="updated_at" type="${date.time.type}" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <createIndex tableName="automation_schedules" indexName="idx_automation_schedules_client_id">
      <column name="client_id"/>
    </createIndex>
    <createIndex tableName="automation_schedules" indexName="idx_automation_schedules_due">
      <column name="enabled"/>
      <column name="next_run_at"/>
    </createIndex>

    <createTable tableName="automation_runs">
      <column name="id" type="${uuid.type}">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="schedule_id" type="${uuid.type}">
        <constraints nullable="false"/>
      </column>
      <column name="client_id" type="${string.type}(64)">
        <constraints nullable="false"/>
      </column>
      <column name="started_at" type="${date.time.type}">
        <constraints nullable="false"/>
      </column>
      <column name="finished_at" type="${date.time.type}"/>
      <column name="status" type="${string.type}(20)">
        <constraints nullable="false"/>
      </column>
      <column name="error_message" type="${string.type}(1000)"/>
      <column name="result_excerpt" type="${clob.type}"/>
      <column name="email_status" type="${string.type}(20)">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <createIndex tableName="automation_runs" indexName="idx_automation_runs_schedule_id">
      <column name="schedule_id"/>
    </createIndex>
    <createIndex tableName="automation_runs" indexName="idx_automation_runs_client_id">
      <column name="client_id"/>
    </createIndex>
  </changeSet>
</databaseChangeLog>
