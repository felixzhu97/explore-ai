    <createIndex indexName="idx_ai_invocation_event_capability_occurred_at" tableName="ai_invocation_event">
      <column name="capability"/>
      <column name="occurred_at"/>
    </createIndex>
    <createIndex indexName="idx_ai_invocation_event_session_id" tableName="ai_invocation_event">
      <column name="session_id"/>
    </createIndex>
    <createIndex indexName="idx_ai_invocation_event_model_occurred_at" tableName="ai_invocation_event">
      <column name="model"/>
      <column name="occurred_at"/>
    </createIndex>
    <createIndex indexName="idx_ai_invocation_event_owner_key" tableName="ai_invocation_event">
      <column name="owner_key"/>
    </createIndex>
  </changeSet>

  <changeSet author="felix.zhu" id="4014d414-5ea0-5495-876c-8c5c22100919" dbms="h2">
    <createTable tableName="skill">
