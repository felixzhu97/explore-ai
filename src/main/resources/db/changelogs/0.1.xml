  <changeSet author="explore-ai" id="0.1-010-automation" dbms="h2">
    <createTable tableName="automation_schedules">
      <column name="id" type="${uuid.type}">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="owner_key" type="${string.type}(80)">
