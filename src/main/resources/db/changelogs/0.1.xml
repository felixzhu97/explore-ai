  <changeSet author="felix.zhu" id="003dff0e-58f7-5e0f-875f-a419955b5ec3" dbms="h2">
    <createTable tableName="automation_schedule">
      <column name="id" type="${uuid.type}">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="owner_key" type="${string.type}(80)">
        <constraints nullable="false"/>
      </column>
      <column name="name" type="${string.type}(120)">
        <constraints nullable="false"/>
      </column>
      <column name="schedule_kind" type="${string.type}(16)" defaultValue="CRON">
        <constraints nullable="false"/>
      </column>
      <column name="cron_expression" type="${string.type}(80)"/>
      <column name="timezone" type="${string.type}(64)">
        <constraints nullable="false"/>
      </column>
      <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
        <constraints nullable="false"/>
      </column>
      <column name="action_type" type="${string.type}(40)">
        <constraints nullable="false"/>
      </column>
      <column name="pipeline_template_id" type="${uuid.type}">
        <constraints nullable="false"/>
      </column>
      <column name="recipient_email" type="${string.type}(320)">
        <constraints nullable="false"/>
      </column>
      <column name="brief" type="${clob.type}">
        <constraints nullable="false"/>
      </column>
      <column name="next_run_at" type="${date.time.type}">
        <constraints nullable="false"/>
      </column>
      <column name="last_run_at" type="${date.time.type}"/>
      <column name="version" type="BIGINT" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="created_at" type="${date.time.type}" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
      <column name="updated_at" type="${date.time.type}" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <createIndex indexName="idx_automation_schedule_owner_key" tableName="automation_schedule">
      <column name="owner_key"/>
    </createIndex>
    <createIndex indexName="idx_automation_schedule_due" tableName="automation_schedule">
      <column name="enabled"/>
      <column name="next_run_at"/>
    </createIndex>

    <createTable tableName="automation_run">
      <column name="id" type="${uuid.type}">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="schedule_id" type="${uuid.type}">
        <constraints nullable="false"/>
      </column>
      <column name="owner_key" type="${string.type}(80)">
        <constraints nullable="false"/>
      </column>
      <column name="started_at" type="${date.time.type}">
        <constraints nullable="false"/>
      </column>
      <column name="finished_at" type="${date.time.type}"/>
      <column name="created_at" type="${date.time.type}" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
      <column name="status" type="${string.type}(20)">
        <constraints nullable="false"/>
      </column>
      <column name="error_message" type="${string.type}(1000)"/>
      <column name="result_excerpt" type="${clob.type}"/>
      <column name="email_status" type="${string.type}(20)">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <createIndex indexName="idx_automation_run_schedule_id" tableName="automation_run">
      <column name="schedule_id"/>
    </createIndex>
    <createIndex indexName="idx_automation_run_owner_key" tableName="automation_run">
      <column name="owner_key"/>
    </createIndex>
  </changeSet>

  <changeSet author="felix.zhu" id="1518a7e4-62d0-5f4b-a937-2ed31977aa4b" dbms="h2">
    <createTable tableName="account">
      <column name="id" type="${uuid.type}">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="provider" type="${string.type}(32)">
        <constraints nullable="false"/>
      </column>
      <column name="subject" type="${string.type}(255)">
        <constraints nullable="false"/>
      </column>
      <column name="email" type="${string.type}(320)"/>
      <column name="display_name" type="${string.type}(255)"/>
      <column name="linked_client_id" type="${string.type}(64)"/>
      <column name="version" type="BIGINT" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="created_at" type="${date.time.type}" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
      <column name="updated_at" type="${date.time.type}" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addUniqueConstraint
      tableName="account"
      columnNames="provider, subject"
      constraintName="uk_account_provider_subject"/>
    <addUniqueConstraint
      tableName="account"
      columnNames="linked_client_id"
      constraintName="uk_account_linked_client_id"/>
  </changeSet>
</databaseChangeLog>
