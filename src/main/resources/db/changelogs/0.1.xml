<?xml version="1.1" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
  "
>
  <changeSet author="felix.zhu" id="0d1af408-6bf8-5bf7-a2ac-592bac5b3bb4" dbms="h2">
    <createTable tableName="rag_document">
      <column name="id" type="${uuid.type}">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="owner_key" type="${string.type}(80)" defaultValue="c:legacy-orphan">
        <constraints nullable="false"/>
      </column>
      <column name="title" type="${string.type}(500)">
        <constraints nullable="false"/>
      </column>
      <column name="file_name" type="${string.type}(255)"/>
      <column name="file_size" type="BIGINT"/>
      <column name="status" type="${string.type}(50)" defaultValue="PROCESSING">
        <constraints nullable="false"/>
      </column>
      <column name="chunk_count" type="INT" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="version" type="BIGINT" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="created_at" type="${date.time.type}" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
      <column name="updated_at" type="${date.time.type}" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <createIndex indexName="idx_rag_document_status" tableName="rag_document">
      <column name="status"/>
    </createIndex>
    <createIndex indexName="idx_rag_document_owner_key" tableName="rag_document">
      <column name="owner_key"/>
    </createIndex>
  </changeSet>

  <changeSet author="felix.zhu" id="a08afedd-ece9-5848-99e8-e14de9e7f52a" dbms="h2">
    <createTable tableName="document_chunk">
      <column name="id" type="${uuid.type}">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="document_id" type="${uuid.type}">
        <constraints nullable="false"/>
      </column>
      <column name="owner_key" type="${string.type}(80)" defaultValue="c:legacy-orphan">
        <constraints nullable="false"/>
      </column>
      <column name="content" type="${clob.type}">
        <constraints nullable="false"/>
      </column>
      <column name="chunk_index" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="metadata" type="${clob.type}"/>
      <column name="embedding" type="${clob.type}"/>
      <column name="created_at" type="${date.time.type}" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addForeignKeyConstraint
      baseTableName="document_chunk"
      baseColumnNames="document_id"
      constraintName="fk_document_chunk_document_id"
      referencedTableName="rag_document"
      referencedColumnNames="id"
      onDelete="CASCADE"/>
    <createIndex indexName="idx_document_chunk_document_id" tableName="document_chunk">
      <column name="document_id"/>
    </createIndex>
    <createIndex indexName="idx_document_chunk_owner_key" tableName="document_chunk">
      <column name="owner_key"/>
    </createIndex>
  </changeSet>

  <changeSet author="felix.zhu" id="79e089c1-5533-5fb0-b383-c1bb6bb3afd2" dbms="h2">
    <createTable tableName="chat_session">
      <column name="id" type="${uuid.type}">
