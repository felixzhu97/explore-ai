      </column>
      <column name="schedule_kind" type="${string.type}(16)" defaultValue="CRON">
        <constraints nullable="false"/>
      </column>
      <column name="cron_expression" type="${string.type}(80)"/>
      <column name="timezone" type="${string.type}(64)">
        <constraints nullable="false"/>
