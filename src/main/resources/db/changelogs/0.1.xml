  </changeSet>

  <changeSet author="felix.zhu" id="85ec1090-f36e-5297-a210-3cc686653977" dbms="h2">
    <createTable tableName="SPRING_AI_CHAT_MEMORY">
      <column name="conversation_id" type="${string.type}(64)">
        <constraints nullable="false"/>
      </column>
      <column name="content" type="LONGVARCHAR">
        <constraints nullable="false"/>
      </column>
      <column name="type" type="${string.type}(10)">
        <constraints nullable="false"/>
      </column>
      <column name="timestamp" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
      <column name="sequence_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <createIndex
      indexName="SPRING_AI_CHAT_MEMORY_CONVERSATION_ID_TIMESTAMP_IDX"
      tableName="SPRING_AI_CHAT_MEMORY">
      <column name="conversation_id"/>
      <column name="timestamp" descending="true"/>
    </createIndex>
    <createIndex
      indexName="SPRING_AI_CHAT_MEMORY_CONVERSATION_ID_SEQUENCE_ID_IDX"
      tableName="SPRING_AI_CHAT_MEMORY">
      <column name="conversation_id"/>
      <column name="sequence_id"/>
    </createIndex>
  </changeSet>

  <changeSet author="felix.zhu" id="933a1069-8517-5d29-b5db-47f7dc885767" dbms="h2">
    <createTable tableName="chat_web_source">
      <column name="conversation_id" type="${string.type}(36)">
        <constraints nullable="false"/>
      </column>
      <column name="content_hash" type="${string.type}(64)">
        <constraints nullable="false"/>
      </column>
      <column name="query" type="${string.type}(512)"/>
      <column name="sources_json" type="${clob.type}">
        <constraints nullable="false"/>
      </column>
      <column name="created_at" type="${date.time.type}">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addPrimaryKey
      tableName="chat_web_source"
      columnNames="conversation_id, content_hash"
      constraintName="pk_chat_web_source"/>
    <createIndex indexName="idx_chat_web_source_conversation_id" tableName="chat_web_source">
      <column name="conversation_id"/>
    </createIndex>
  </changeSet>

  <changeSet author="felix.zhu" id="69b7a243-a9fd-5404-ac3e-fd2cadf3ff2d" dbms="h2">
    <createTable tableName="ai_invocation_event">
      <column name="id" type="${uuid.type}">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="owner_key" type="${string.type}(80)" defaultValue="c:legacy-orphan">
        <constraints nullable="false"/>
      </column>
      <column name="occurred_at" type="${date.time.type}">
        <constraints nullable="false"/>
      </column>
      <column name="created_at" type="${date.time.type}" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
      <column name="capability" type="${string.type}(32)">
        <constraints nullable="false"/>
      </column>
      <column name="operation" type="${string.type}(64)">
        <constraints nullable="false"/>
      </column>
      <column name="outcome" type="${string.type}(16)">
        <constraints nullable="false"/>
      </column>
      <column name="latency_ms" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="provider" type="${string.type}(64)"/>
      <column name="model" type="${string.type}(128)"/>
      <column name="session_id" type="${string.type}(36)"/>
      <column name="document_id" type="${string.type}(36)"/>
      <column name="agent_type" type="${string.type}(64)"/>
      <column name="tool_name" type="${string.type}(128)"/>
      <column name="prompt_tokens" type="INT"/>
      <column name="completion_tokens" type="INT"/>
      <column name="error_code" type="${string.type}(64)"/>
      <column name="error_message" type="${string.type}(512)"/>
