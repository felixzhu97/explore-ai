# Local profile: MCP client is OFF by default so bootRun is not blocked by STDIO
# (e.g. missing uvx / mcp-server-fetch). Enable explicitly when needed.
#
#   SPRING_PROFILES_ACTIVE=local
#
# Production / shared envs should use Streamable HTTP MCP, not STDIO:
#   https://docs.spring.io/spring-ai/reference/api/mcp/mcp-client-boot-starter-docs.html
#
# Optional MCP Client — connection keys become Host server names for Tools/Resources/Prompts.
# STDIO Fetch (requires uv/uvx: https://docs.astral.sh/uv/):
# spring:
#   ai:
#     mcp:
#       client:
#         enabled: true
#         stdio:
#           connections:
#             fetch:
#               command: uvx
#               args:
#                 - mcp-server-fetch
#         streamable-http:
#           connections:
#             remote:
#               url: http://localhost:8080
#               endpoint: /mcp
spring:
  ai:
    mcp:
      client:
        enabled: false
